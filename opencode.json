{
  "$schema": "https://opencode.ai/config.json",
  "model": "anthropic/claude-sonnet-4-6",
  "instructions": ["AGENTS.md", "CLAUDE.md", "GEMINI.md", ".cursorrules", ".codex/config.toml"],
  "permission": {
    "read": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow"
    },
    "edit": {
      "*": "ask",
      ".github/**": "deny",
      "infrastructure/**": "ask"
    },
    "bash": {
      "*": "ask",
      "git status *": "allow",
      "git diff *": "allow",
      "pnpm *": "allow",
      "npm *": "allow",
      "npx *": "allow",
      "node plugins/acmm/*": "allow",
      "node --test *": "allow",
      "rm *": "deny"
    }
  },
  "agent": {
    "plan": {
      "model": "anthropic/claude-sonnet-4-6"
    },
    "build": {
      "model": "anthropic/claude-sonnet-4-6"
    }
  },
  "mcp": {
    "filesystem": {
      "type": "local",
      "command": ["npx", "-y", "@modelcontextprotocol/server-filesystem", "."]
    }
  }
}
