{
  "name": "mattbutlerengineering",
  "private": true,
  "packageManager": "pnpm@9.15.4",
  "scripts": {
    "dev": "turbo run dev",
    "dev:local": "docker compose -f infrastructure/docker-compose.yml up postgres -d --wait && pnpm env:init && pnpm db:push && turbo run dev",
    "env:init": "pnpm --filter './services/*' exec sh -c '[ -f .env ] || cp .env.example .env'",
    "db:push": "pnpm --filter './services/*' exec prisma db push --skip-generate",
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "clean": "turbo run clean && rm -rf node_modules",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "pnpm --filter @mbe/rialto build && changeset publish",
    "test:visual": "playwright test --config apps/rialto-web/playwright.config.ts",
    "test:e2e:hospitality": "playwright test --config apps/hospitality/playwright.config.ts",
    "lighthouse": "lhci autorun",
    "size": "pnpm --filter @mbe/rialto exec size-limit",
    "size:check": "pnpm --filter @mbe/rialto exec size-limit --limit",
    "prepare": "husky"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^0.5.2",
    "@changesets/cli": "^2.29.8",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.58.2",
    "@size-limit/file": "^12.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "size-limit": "^12.0.0",
    "turbo": "^2.9.1"
  },
  "lint-staged": {
    "apps/**/*.{ts,tsx}": [
      "eslint --fix --flag v10_config_lookup_from_file"
    ],
    "packages/**/*.{ts,tsx}": [
      "eslint --fix --flag v10_config_lookup_from_file"
    ],
    "services/**/*.{ts,tsx}": [
      "eslint --fix --flag v10_config_lookup_from_file"
    ],
    "tools/**/*.{ts,tsx}": [
      "eslint --fix --flag v10_config_lookup_from_file"
    ]
  },
  "pnpm": {
    "overrides": {
      "tar": ">=7.5.8",
      "rollup": ">=4.59.0",
      "@isaacs/brace-expansion": ">=5.0.1",
      "brace-expansion": ">=5.0.5",
      "picomatch": ">=4.0.4",
      "path-to-regexp@<0.1.13": ">=0.1.13",
      "serialize-javascript@<7.0.5": ">=7.0.5",
      "yaml@>=2.0.0 <2.8.3": ">=2.8.3",
      "tmp": ">=0.2.4",
      "minimatch@<3.1.4": "3.1.4",
      "minimatch@>=5.0.0 <5.1.8": "5.1.8",
      "minimatch@>=9.0.0 <9.0.7": "9.0.7",
      "minimatch@>=10.0.0 <10.2.3": "10.2.3"
    }
  }
}
