{
  "name": "mattbutlerengineering",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=22",
    "pnpm": ">=9"
  },
  "scripts": {
    "dev": "turbo run dev",
    "dev:local": "docker compose -f infrastructure/docker-compose.yml up postgres -d --wait && pnpm env:init && pnpm db:push && pnpm db:generate && turbo run dev",
    "env:init": "pnpm --filter './services/*' exec sh -c '[ -f .env ] || cp .env.example .env'",
    "db:push": "pnpm --filter './services/*' exec prisma db push",
    "db:generate": "pnpm --filter './services/*' exec prisma generate",
    "repo-audit": "pnpm check:prettier && node scripts/check-circular-deps.js && node scripts/check-dep-versions.js && node scripts/check-env-sync.js && node scripts/check-service-bindings.js && node scripts/check-destructive-migrations.js && node scripts/check-dockerfile-deps.js && node scripts/check-schema-compat.js && node scripts/check-ci-dispatch.mjs && node scripts/check-issue-filing-seam.mjs && node scripts/check-workflow-deps.mjs && node scripts/check-workflow-paths-coverage.mjs && node scripts/check-hook-wiring.mjs && node scripts/check-deploy-secret-provisioning.mjs && node scripts/check-orphaned-tests.mjs && node scripts/check-orphaned-collectors.mjs && node scripts/check-story-coverage.mjs && node scripts/check-rialto-changeset.mjs && pnpm check:boundaries && pnpm audit --audit-level=high",
    "check:prettier": "prettier --check .",
    "check:boundaries": "depcruise apps services packages tools --config .dependency-cruiser.cjs",
    "check:circular-deps": "node scripts/check-circular-deps.js",
    "check:dep-versions": "node scripts/check-dep-versions.js",
    "check:service-bindings": "node scripts/check-service-bindings.js",
    "check:destructive-migrations": "node scripts/check-destructive-migrations.js",
    "check:dockerfiles": "node scripts/check-dockerfile-deps.js",
    "check:env-sync": "node scripts/check-env-sync.js",
    "check:ci-dispatch": "node scripts/check-ci-dispatch.mjs",
    "check:issue-filing-seam": "node scripts/check-issue-filing-seam.mjs",
    "check:workflow-deps": "node scripts/check-workflow-deps.mjs",
    "check:workflow-paths-coverage": "node scripts/check-workflow-paths-coverage.mjs",
    "check:hook-wiring": "node scripts/check-hook-wiring.mjs",
    "check:deploy-secret-provisioning": "node scripts/check-deploy-secret-provisioning.mjs",
    "check:orphaned-tests": "node scripts/check-orphaned-tests.mjs",
    "check:orphaned-collectors": "node scripts/check-orphaned-collectors.mjs",
    "check:story-coverage": "node scripts/check-story-coverage.mjs",
    "check:rialto-changeset": "node scripts/check-rialto-changeset.mjs",
    "check:markdown": "node scripts/audit-markdown.mjs",
    "graph": "node scripts/generate-dep-graph.js",
    "generate:dep-graph": "node scripts/generate-dep-graph.mjs",
    "check:schema-compat": "node scripts/check-schema-compat.js",
    "check:ai-antipatterns": "node scripts/check-ai-antipatterns.mjs",
    "check:ai-antipatterns:update": "node scripts/check-ai-antipatterns.mjs --update",
    "schema:baseline": "tsx scripts/update-schema-baselines.js",
    "log:cost": "node scripts/log-agent-cost.js",
    "generate:audit-inventory": "node scripts/generate-audit-inventory.mjs",
    "regen": "node scripts/regen.mjs",
    "regen:check": "node scripts/regen.mjs --check",
    "build": "turbo run build",
    "test": "turbo run test",
    "test:contract": "turbo run test:contract",
    "test:mutations": "stryker run",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "clean": "turbo run clean && rm -rf node_modules",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "pnpm --filter @mattbutlerengineering/rialto build && changeset publish",
    "test:visual": "playwright test --config apps/rialto-web/playwright.config.ts",
    "test:e2e:hospitality": "playwright test --config apps/hospitality/playwright.config.ts",
    "lighthouse": "lhci autorun",
    "size": "turbo run size",
    "size:check": "turbo run size:check",
    "pre-commit:full": "pnpm lint-staged && pnpm turbo typecheck --filter='...[HEAD]' && pnpm repo-audit",
    "prepare": "husky"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^1.0.0",
    "@changesets/cli": "^3.0.1",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.62.1",
    "@size-limit/file": "^13.0.3",
    "@stryker-mutator/core": "^10.0.0",
    "@stryker-mutator/vitest-runner": "^10.0.0",
    "dependency-cruiser": "^18.2.0",
    "esbuild": "^0.28.2",
    "glob": "^13.0.6",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "size-limit": "^13.0.3",
    "turbo": "^2.10.11",
    "vitest": "catalog:"
  },
  "pnpm": {
    "overrides": {
      "@anthropic-ai/sdk@<0.94": "^0.93.0",
      "tar@<8": "^7.5.22",
      "undici": ">=7.28.0 <8",
      "flatted@<4": "^3.4.3",
      "effect@<4": "^3.22.0",
      "rollup@<5": "^4.62.4",
      "brace-expansion@<5.0.9": "^5.0.9",
      "find-my-way@<9.7.0": "^9.7.0",
      "js-yaml@>=5.0.0 <5.2.2": ">=5.2.2 <6",
      "picomatch@<5": "^4.0.5",
      "path-to-regexp@<8.4.2": "^8.4.2",
      "serialize-javascript@<7.1.0": "^7.1.0",
      "yaml@<2.9.0": "^2.9.0",
      "tmp@<0.2.7": "^0.2.7",
      "minimatch@<3.1.4": "3.1.4",
      "minimatch@>=5.0.0 <5.1.8": "5.1.8",
      "minimatch@>=9.0.0 <9.0.7": "9.0.7",
      "minimatch@>=10.0.0 <10.2.3": "10.2.3",
      "lodash@<5": "^4.18.1",
      "lodash-es@<5": "^4.18.1",
      "esbuild@<0.28.1": "^0.28.1",
      "protobufjs@>=8.0.0 <8.0.2": "^8.0.2",
      "protobufjs@<=7.6.2": "^8.7.2",
      "@babel/plugin-transform-modules-systemjs": ">=7.29.4 <8",
      "@babel/preset-env": ">=7.29.5 <8",
      "basic-ftp@<6.0.1": "^6.0.1",
      "ip-address@<10.1.1": ">=10.1.1 <11",
      "fast-uri@<3.1.5": ">=3.1.5 <4",
      "fast-uri@>=4.0.0 <4.1.1": ">=4.1.1 <5",
      "hono@<4.13.0": "^4.13.0",
      "@hono/node-server@<2.0.12": "^2.0.12",
      "uuid@<14.0.0": "^14.0.0",
      "@opentelemetry/sdk-node@<0.217.0": "^0.217.0",
      "@opentelemetry/exporter-prometheus@<0.217.0": "^0.217.0",
      "@opentelemetry/core@<2.10.0": "^2.10.0",
      "@pulumi/pulumi>@opentelemetry/sdk-trace-base": "^2.8.0",
      "@pulumi/pulumi>@opentelemetry/sdk-trace-node": "^2.8.0",
      "@pulumi/pulumi>@opentelemetry/resources": "^2.8.0",
      "@pulumi/pulumi>@opentelemetry/exporter-zipkin": "^2.8.0",
      "@pulumi/pulumi>@opentelemetry/exporter-trace-otlp-grpc": "^0.219.0",
      "@pulumi/pulumi>@opentelemetry/instrumentation": "^0.219.0",
      "@pulumi/pulumi>@opentelemetry/instrumentation-grpc": "^0.219.0",
      "qs@<=6.15.1": "^6.15.2",
      "@babel/core@<=7.29.5": ">=7.29.6 <8",
      "ioredis@<7": "^6.0.0",
      "form-data@<4.0.6": "^4.0.6",
      "axios@<1.18.0": ">=1.18.0 <2",
      "js-yaml@<4.3.1": "^4.3.1",
      "read-yaml-file>js-yaml": "3.15.1",
      "@fastify/static@<10.1.2": ">=10.1.2 <11",
      "body-parser@<1.20.6": "^1.20.6",
      "postcss@<8.5.26": "^8.5.26",
      "@puppeteer/browsers@<3.2.0": "^3.2.0",
      "deepmerge-ts@<8.0.0": "^8.0.0",
      "browserslist@<4.28.7": "^4.28.7",
      "mysql2@<3.22.0": "^3.22.0"
    }
  },
  "license": "MIT"
}
