{
  "name": "mattbutlerengineering",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  },
  "scripts": {
    "dev": "turbo run dev",
    "dev:local": "docker compose -f infrastructure/docker-compose.yml up postgres -d --wait && pnpm env:init && pnpm db:push && turbo run dev",
    "env:init": "pnpm --filter './services/*' exec sh -c '[ -f .env ] || cp .env.example .env'",
    "db:push": "pnpm --filter './services/*' exec prisma db push",
    "repo-audit": "node scripts/check-circular-deps.js && node scripts/check-dep-versions.js && node scripts/check-env-sync.js && node scripts/check-service-bindings.js && node scripts/check-destructive-migrations.js && node scripts/check-dockerfile-deps.js && node scripts/check-schema-compat.js && pnpm audit --audit-level=high",
    "check:circular-deps": "node scripts/check-circular-deps.js",
    "check:dep-versions": "node scripts/check-dep-versions.js",
    "check:service-bindings": "node scripts/check-service-bindings.js",
    "check:destructive-migrations": "node scripts/check-destructive-migrations.js",
    "check:dockerfiles": "node scripts/check-dockerfile-deps.js",
    "check:env-sync": "node scripts/check-env-sync.js",
    "graph": "node scripts/generate-dep-graph.js",
    "generate:dep-graph": "node scripts/generate-dep-graph.mjs",
    "check:schema-compat": "node scripts/check-schema-compat.js",
    "check:ai-antipatterns": "node scripts/check-ai-antipatterns.mjs",
    "check:ai-antipatterns:update": "node scripts/check-ai-antipatterns.mjs --update",
    "schema:baseline": "tsx scripts/update-schema-baselines.js",
    "log:cost": "node scripts/log-agent-cost.js",
    "generate:audit-inventory": "node scripts/generate-audit-inventory.mjs",
    "regen": "node scripts/regen.mjs",
    "regen:check": "node scripts/regen.mjs --check",
    "build": "turbo run build",
    "test": "turbo run test",
    "test:contract": "turbo run test:contract",
    "test:mutations": "stryker run",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "clean": "turbo run clean && rm -rf node_modules",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "pnpm --filter @mattbutlerengineering/rialto build && changeset publish",
    "test:visual": "playwright test --config apps/rialto-web/playwright.config.ts",
    "test:e2e:hospitality": "playwright test --config apps/hospitality/playwright.config.ts",
    "lighthouse": "lhci autorun",
    "size": "turbo run size",
    "size:check": "turbo run size:check",
    "pre-commit:full": "pnpm lint-staged && pnpm turbo typecheck --filter='...[HEAD]' && pnpm repo-audit",
    "prepare": "husky"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^0.7.0",
    "esbuild": "^0.28.0",
    "@changesets/cli": "^2.31.0",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.61.0",
    "@size-limit/file": "^12.1.0",
    "@stryker-mutator/core": "^9.6.1",
    "@stryker-mutator/vitest-runner": "^9.6.1",
    "glob": "^13.0.6",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.7",
    "size-limit": "^12.1.0",
    "turbo": "^2.9.18",
    "vitest": "catalog:"
  },
  "pnpm": {
    "overrides": {
      "@anthropic-ai/sdk": ">=0.81.0",
      "tar": ">=7.5.11",
      "undici": ">=7.24.0 <8",
      "flatted": ">=3.4.2",
      "effect": ">=3.20.0",
      "rollup": ">=4.59.0",
      "@isaacs/brace-expansion": ">=5.0.1",
      "brace-expansion": ">=5.0.5",
      "picomatch": ">=4.0.4",
      "path-to-regexp@<0.1.13": ">=0.1.13",
      "serialize-javascript@<7.0.5": ">=7.0.5",
      "yaml@>=2.0.0 <2.8.3": ">=2.8.3",
      "tmp@<0.2.6": "^0.2.6",
      "minimatch@<3.1.4": "3.1.4",
      "minimatch@>=5.0.0 <5.1.8": "5.1.8",
      "minimatch@>=9.0.0 <9.0.7": "9.0.7",
      "minimatch@>=10.0.0 <10.2.3": "10.2.3",
      "lodash": ">=4.18.0",
      "lodash-es": ">=4.18.0",
      "esbuild@<0.28.1": "^0.28.1",
      "protobufjs@<7.5.8": "^7.5.8",
      "protobufjs@>=8.0.0 <8.0.2": "^8.0.2",
      "@babel/plugin-transform-modules-systemjs": ">=7.29.4",
      "@babel/preset-env": ">=7.29.5",
      "basic-ftp@<5.3.1": ">=5.3.1",
      "ip-address": ">=10.1.1",
      "fast-uri@<3.1.1": ">=3.1.1",
      "hono@<4.12.16": ">=4.12.16",
      "@hono/node-server@<1.19.13": ">=1.19.13",
      "@fastify/static@<9.1.1": ">=9.1.1",
      "uuid@<14.0.0": ">=14.0.0",
      "@babel/plugin-transform-modules-systemjs@<7.29.4": "^7.29.4",
      "@opentelemetry/sdk-node@<0.217.0": "^0.217.0",
      "@opentelemetry/exporter-prometheus@<0.217.0": "^0.217.0",
      "qs@<=6.15.1": "^6.15.2",
      "ioredis": "^5.11.0"
    }
  },
  "license": "MIT"
}
