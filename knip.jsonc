{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  // eslint configs are loaded by eslint, not imported; k6 script is run by k6
  // (its `k6/http` import is not an npm package); scanner fixtures are test data;
  // docs/reference holds vendored source that is read, never built;
  // derive-path.d.mts is the type declaration TypeScript pairs with the imported
  // derive-path.mjs (apps/rialto-web), never imported by name;
  // generate-og-images.mjs is a manual one-time generator (#4857) for the
  // committed per-app OG share cards, run by hand when a card is redrawn.
  "ignore": [
    "**/eslint.config.js",
    ".github/workflows/load-test.js",
    "docs/reference/**",
    "scripts/ui-quality/derive-path.d.mts",
    "scripts/generate-og-images.mjs",
  ],
  // Only types and interfaces may be exported solely for use inside their own
  // file (a documented props/shape contract). Values and functions exported but
  // imported nowhere are dead exports and are flagged (#7488).
  "ignoreExportsUsedInFile": { "interface": true, "type": true },
  "ignoreIssues": {
    // Barrel files that deliberately re-export a component's full public surface
    // (props types, sub-components) for in-app consumers.
    "apps/hospitality/src/components/*/index.ts": ["exports", "types"],
    "packages/agent-core/src/phases/index.ts": ["types"],
    // Documented module API (plugins/acmm/skills/acmm-audit/SKILL.md).
    "plugins/acmm/scripts/sources/index.js": ["exports"],
    // useUpdateGuest is the mutation hook for the guest-edit flow (known P1 gap in
    // apps/hospitality/CLAUDE.md); it is referenced by docs/fixes/floor-plan-cache-keys.
    "apps/hospitality/src/hooks/useGuests.ts": ["exports"],
  },
  // CLIs that are provided by the toolchain / invoked via pnpm exec, not declared per package.
  "ignoreBinaries": ["eslint", "prettier", "tsx", "vite", "prisma"],
  "workspaces": {
    ".": {
      "entry": [
        "lighthouserc*.cjs",
        "stryker.config.mjs",
        // Explicit, not globs: knip-entry-roots.test.mjs asserts each hook is wired in
        // .claude/settings.json (or imported by a hook) and each skill script is named
        // in its SKILL.md, and that no new one is missing from this list.
        ".claude/hooks/hook-input.mjs",
        ".claude/hooks/secret-scan.mjs",
        ".claude/skills/sentry-triage/scripts/fetch-issues.mjs",
        ".claude/skills/sentry-triage/scripts/triage.mjs",
      ],
    },
    "apps/*": {
      "entry": ["playwright*.config.ts", "e2e/**/*.{ts,tsx}"],
    },
    "apps/hospitality": {
      "entry": ["playwright*.config.ts", "e2e/**/*.{ts,tsx}", "src/**/*.typecheck.ts"],
      // @json-render/react: named in vite.manualChunks.ts to split its chunk.
      // axe-core: peer of @axe-core/playwright (E2E a11y).
      "ignoreDependencies": ["@json-render/react", "axe-core"],
    },
    "apps/rialto-web": {
      "entry": [
        "playwright*.config.ts",
        "e2e/**/*.{ts,tsx}",
        "src/main.tsx",
        "src/**/*.test.{ts,tsx}",
        "src/setupTests.ts",
        "*.config.test.ts",
      ],
      // The vite/vitest config resolves the gitignored packages/rialto/dist/manifest.json
      // at load time; knip must run with no build, so skip the plugins' config loading
      // (the app entry, tests and setup file are listed explicitly instead).
      "vite": false,
      "vitest": false,
      // @mbe/api-client: rialto's ChatPanel imports it; kept as a workspace dep
      // so turbo's prebuild chain (types -> api-client -> app) holds
      // (see e2e/build-script.test.ts).
      "ignoreDependencies": ["@mbe/api-client"],
    },
    "packages/rialto": {
      "entry": [
        "playwright*.config.ts",
        "vite.config.*.ts",
        "scripts/*.ts",
        "src/lib-entry.ts",
        "src/hooks/index.ts",
        "src/providers/index.ts",
        "src/components/*/index.ts",
        "src/components/*/*.catalog.ts",
        "src/showcase/main.tsx",
      ],
      // axe-core: peer of the Storybook a11y addon. eslint-plugin-storybook:
      // loaded from eslint.config.js (ignored above).
      "ignoreDependencies": ["axe-core", "eslint-plugin-storybook"],
    },
    "packages/rialto-plugin": {
      "entry": ["hooks/*.mjs"],
      // Plugin validation hook resolves rialto at runtime.
      "ignoreDependencies": ["@mattbutlerengineering/rialto"],
    },
    "packages/sentry": {
      // Optional peer, used by consumers' Fastify apps.
      "ignoreDependencies": ["fastify"],
    },
    "packages/service-bootstrap": {
      // error-handler.sentry.test.ts imports @sentry/node, provided via @mbe/sentry.
      "ignoreDependencies": ["@sentry/node"],
    },
    "plugins/acmm": {
      "entry": ["scripts/*.js"],
      // prettier is provided by the repo root toolchain; @mbe/config via eslint.config.js.
      "ignoreDependencies": ["prettier", "@mbe/config"],
    },
    // Per service: Prisma client/adapter are imported by the generated client
    // (ignored); @mbe/sentry is a Docker/turbo build-graph dep;
    // pg is loaded by the Prisma pg adapter.
    "services/agent": {
      "ignoreDependencies": [
        "@prisma/adapter-pg",
        "@prisma/client",
        "@prisma/client-runtime-utils",
        "@mbe/sentry",
        "pg",
        "@types/pg",
      ],
    },
    "services/reservations": {
      // @fastify/rate-limit: never imported here, but its module augmentation types
      // the per-route `config: { rateLimit }` the routes declare.
      "ignoreDependencies": [
        "@prisma/client",
        "@prisma/client-runtime-utils",
        "@mbe/sentry",
        "@fastify/rate-limit",
      ],
    },
    "services/users": {
      "ignoreDependencies": [
        "@prisma/adapter-pg",
        "@prisma/client",
        "@prisma/client-runtime-utils",
        "@mbe/sentry",
        "pg",
        "@types/pg",
      ],
    },
    "tools/cli": {
      "entry": ["src/check-adr.ts"],
    },
    "tools/mutation-testing": {
      // Driven by the root stryker.config.mjs / README commands.
      "ignoreDependencies": ["@stryker-mutator/core", "@stryker-mutator/vitest-runner", "vitest"],
    },
    "infrastructure/pulumi": {
      "entry": ["*.ts"],
      // Pulumi providers are loaded by the engine, not imported.
      "ignoreDependencies": ["@pulumi/github", "@pulumi/random"],
    },
    "scripts": {
      // Roots are the files something outside the import graph runs by path
      // (package.json scripts, workflow run: lines, husky/Claude hooks, skill and
      // routine docs) plus the test tree. No catch-all glob: a script nothing
      // references or imports is dead. The per-file list is kept equal to the
      // references found by scripts/lib/knip-entry-roots.mjs (print it with
      // `node scripts/lib/knip-entry-roots.mjs`) by knip-entry-roots.test.mjs.
      "entry": [
        "__tests__/**/*.{js,mjs,mts,ts}",
        "vitest.config.mjs",
        "acmm-merge-issues-created.mjs",
        "acmm-regression-check.mjs",
        "acmm/repo-bench.js",
        "acmm/review-burden-metrics.js",
        "agent-core-build-freshness.mjs",
        "agent-spend-telemetry.mjs",
        "api-failures.mjs",
        "approve-automation-runs.mjs",
        "assert-vitest-ran.mjs",
        "audit-markdown.mjs",
        "audit-transient-error.mjs",
        "auto-retry-stale.mjs",
        "bootstrap-worktree.mjs",
        "branch-cleanup.mjs",
        "changeset-hook.mjs",
        "chaos-agent.mjs",
        "check-ai-antipatterns.mjs",
        "check-analytics-bindings.mjs",
        "check-api-surface-invariants.mjs",
        "check-audit-persistence-caller.mjs",
        "check-changeset-tree.mjs",
        "check-ci-dispatch.mjs",
        "check-ci-gate-coverage.mjs",
        "check-circular-deps.js",
        "check-claude-md-package-refs.mjs",
        "check-claude-md-table-drift.mjs",
        "check-cursorrules-drift.mjs",
        "check-dep-sync.mjs",
        "check-dep-versions.js",
        "check-deploy-secret-provisioning.mjs",
        "check-deploy-sha.mjs",
        "check-destructive-migrations.js",
        "check-doc-freshness.mjs",
        "check-dockerfile-deps.js",
        "check-endpoint.mjs",
        "check-env-sync.js",
        "check-hook-wiring.mjs",
        "check-hooks-active.mjs",
        "check-i18n-catalogs.mjs",
        "check-issue-filing-seam.mjs",
        "check-large-files.mjs",
        "check-memory-refs.mjs",
        "check-orphaned-cli-commands.mjs",
        "check-orphaned-collectors.mjs",
        "check-orphaned-tests.mjs",
        "check-regen-needed.mjs",
        "check-rialto-changeset.mjs",
        "check-schema-compat.js",
        "check-service-bindings.js",
        "check-skill-references.mjs",
        "check-story-coverage.mjs",
        "check-visual-tolerance-change.mjs",
        "check-workflow-deps.mjs",
        "check-workflow-paths-coverage.mjs",
        "ci-gate-commit-status.mjs",
        "ci-gate-required-results.mjs",
        "ci-gate-status.mjs",
        "circuit-breaker-deploy-failures.mjs",
        "classify-mutation-run.mjs",
        "collect-ai-issue-feedback.mjs",
        "collect-queue-telemetry-from-github.mjs",
        "collect-repo-stats.mjs",
        "collect-sdlc-speed.mjs",
        "collect-shipped-features.mjs",
        "cors-audit.mjs",
        "dependabot-auto-merge-policy.mjs",
        "deploy-ci-precondition.mjs",
        "detect-instruction-rot.mjs",
        "discover-prisma-services.mjs",
        "e2e-auth-preflight.mjs",
        "e2e-failure-rate.mjs",
        "format-mutation-issue.mjs",
        "generate-acmm-report.mjs",
        "generate-audit-inventory.mjs",
        "generate-dep-graph.js",
        "generate-dep-graph.mjs",
        "generate-metrics-json.mjs",
        "gh-diff-failure.mjs",
