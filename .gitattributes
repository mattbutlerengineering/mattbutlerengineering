# Append-only telemetry files written by concurrent sessions (local loops +
# cloud routines). union merge keeps both sides' appended lines instead of
# conflicting — ordering within the file is not semantically meaningful.
metrics/*.jsonl merge=union
# Exception: the ui-quality coverage ledger is rewritten in place (one row per
# route), not appended — union would keep both sides' copy of a row. Later
# lines win in .gitattributes, so this must stay after the glob above.
metrics/ui-quality-ledger.jsonl -merge
metrics/production-health/*.jsonl merge=union
.claude/improvement-loop/log.md merge=union
