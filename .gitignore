.docker/

# Git worktrees
.worktrees/
.agent-worktrees/
.claude/worktrees/
.claire/worktrees/

# Install sentinel written by implement-queue workers (ephemeral, never commit)
.worktree-installed

# Agent scratch/planning state (RIPER workflow, mbe stats --auto-plan)
.planning/

# Misc
*.tsbuildinfo

# Prisma native binaries (platform-specific, generated at runtime)
*.so.node
*.dylib.node

# Prisma WASM base64 (generated at runtime, high-entropy — do not commit)
**/query_compiler_fast_bg.wasm-base64.js

# Prisma generated clients (produced by `prisma generate` at install/build time)
services/*/src/generated/

# Build-time repo stats for the marketing proof strip (scripts/collect-repo-stats.mjs).
# The committed repo-stats.fallback.json next to it is the offline source of truth.
apps/marketing/src/data/generated/

# Claude Code (keep skills, ignore local settings)
.claude/settings.local.json
.claude/agent-spend.jsonl
.claude/governor-state.json
.claude/session-logs/*.json
# Ignore acmm dir *contents* (not the dir itself) so the negations below can
# re-include the tracked files — git won't descend into a dir ignored as a whole.
.claude/acmm/*
# These ACMM files are intentionally tracked and required in a fresh checkout
# (regression baseline + scanner inputs).
!.claude/acmm/state.json
!.claude/acmm/repo-bench-results.json
!.claude/acmm/onboarding-benchmark.json
.claude/*.lock
.superpowers/

# Graphify local artifacts (reports, graph.json, cache)
graphify-out/
graphify-out-*/

# Agent debug output dumps
*_output*.txt
lint_*.txt
lint_*.json
build_output*.txt
rialto_build_error.txt
rialto_lint.txt
test.txt

# Test artifacts
playwright-report/
test-results/

# Stryker mutation testing artifacts
.stryker-tmp/
reports/mutation/
# Durable runtime telemetry (#3645). The block below is DERIVED from the
# `durable` flags in scripts/metrics-store.mjs — edit the registry, then run
# `node scripts/metrics-store.mjs --sync-gitignore`. Drift is a test failure
# (scripts/__tests__/durable-manifest.test.mjs).
# >>> BEGIN generated durable-metrics block — scripts/metrics-store.mjs
# Do not edit by hand — run `node scripts/metrics-store.mjs --sync-gitignore`.
# Every path below is durable: scheduled routines run in ephemeral checkouts,
# so an untracked append is lost with the checkout. Append-only churn is
# handled by merge=union in .gitattributes.
/.claude/improvement-loop/*
!/.claude/improvement-loop/log.md
!/.claude/improvement-loop/revert-log.md
/metrics/*
!/metrics/a11y-history.jsonl
!/metrics/acmm-evals.jsonl
!/metrics/agent-perf.jsonl
!/metrics/ai-antipattern-baselines.json
!/metrics/ai-issue-feedback.json
!/metrics/domain-metrics.jsonl
!/metrics/eval-reports.jsonl
!/metrics/instruction-changes.jsonl
!/metrics/last-audit.json
!/metrics/pr-acceptance.json
!/metrics/process-metrics.jsonl
!/metrics/production-health/
!/metrics/production-health/*
!/metrics/queue-telemetry.jsonl
!/metrics/review-burden.json
!/metrics/sensor-report.jsonl
!/metrics/service-health.jsonl
!/metrics/stale-human-blocked.jsonl
!/metrics/threshold-changes.jsonl
!/metrics/verifications.jsonl
# <<< END generated durable-metrics block

