.docker/

# Git worktrees
.worktrees/
.agent-worktrees/
.claude/worktrees/
.claire/worktrees/

# Install sentinel written by implement-queue workers (ephemeral, never commit)
.worktree-installed

# Agent scratch/planning state (RIPER workflow, mbe stats --auto-plan)
.planning/

# Misc
*.tsbuildinfo

# Prisma native binaries (platform-specific, generated at runtime)
*.so.node
*.dylib.node

# Prisma WASM base64 (generated at runtime, high-entropy — do not commit)
**/query_compiler_fast_bg.wasm-base64.js

# Prisma generated clients (produced by `prisma generate` at install/build time)
services/*/src/generated/

# Build-time repo stats for the marketing proof strip (scripts/collect-repo-stats.mjs).
# The committed repo-stats.fallback.json next to it is the offline source of truth.
apps/marketing/src/data/generated/

# Claude Code (keep skills, ignore local settings)
.claude/settings.local.json
# Ignore improvement-loop *contents* (not the dir itself) so the negation below
# can re-include the tracked audit log — git won't descend into a dir ignored
# as a whole.
.claude/improvement-loop/*
# The improvement-loop audit log is intentionally tracked: cloud routines run in
# ephemeral checkouts, so untracked appends are lost with the checkout.
!.claude/improvement-loop/log.md
.claude/agent-spend.jsonl
.claude/governor-state.json
.claude/session-logs/*.json
# Ignore acmm dir *contents* (not the dir itself) so the negations below can
# re-include the tracked files — git won't descend into a dir ignored as a whole.
.claude/acmm/*
# These ACMM files are intentionally tracked and required in a fresh checkout
# (regression baseline + scanner inputs).
!.claude/acmm/state.json
!.claude/acmm/repo-bench-results.json
!.claude/acmm/onboarding-benchmark.json
.claude/*.lock
.superpowers/

# Graphify local artifacts (reports, graph.json, cache)
graphify-out/
graphify-out-*/

# Agent debug output dumps
*_output*.txt
lint_*.txt
lint_*.json
build_output*.txt
rialto_build_error.txt
rialto_lint.txt
test.txt

# Test artifacts
playwright-report/
test-results/

# Stryker mutation testing artifacts
.stryker-tmp/
reports/mutation/
# Single home for tracked runtime telemetry: metrics/. Everything under it
# is ignored except the specific files below (baselines, evals, and
# audit-trail logs written by the self-tuning scripts). queue-telemetry.jsonl
# is tracked as of the ideation-loop work: the implement-queue drain now runs
# in ephemeral cloud checkouts, so untracked rows evaporate before the sensor
# can reconcile them. Append-only churn is handled by merge=union in
# .gitattributes.
/metrics/*
!/metrics/queue-telemetry.jsonl
!/metrics/ai-antipattern-baselines.json
!/metrics/acmm-evals.jsonl
!/metrics/instruction-changes.jsonl
!/metrics/process-metrics.jsonl
!/metrics/threshold-changes.jsonl
!/metrics/agent-perf.jsonl
!/metrics/last-audit.json
!/metrics/pr-acceptance.json
!/metrics/review-burden.json
!/metrics/eval-reports.jsonl
# production-feedback.yml's per-day snapshots (#3623) -- a subdirectory, not
# a single file, so it needs its own directory exception plus a file
# exception for the dynamically-dated files inside it.
!/metrics/production-health/
!/metrics/production-health/*.jsonl

# Playwright
e2e/.auth/
e2e/test-results/
e2e/screenshots/
.playwright-cli/

# Lighthouse CI
.lighthouseci/
.lighthouseci-*/

# Audit state (per-environment, not committed)
.audit-state/

*storybook.log
storybook-static

# Playwright MCP browser session artifacts
.playwright-mcp/

# AI-generated plan/spec docs (superpowers artifacts)
docs/superpowers/plans/
docs/superpowers/specs/

# CI-generated a11y test output (ci.yml writes it, process-a11y-results.mjs consumes it)
a11y-results.json
