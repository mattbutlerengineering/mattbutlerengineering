{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": [
    "pnpm-lock.yaml",
    "tsconfig.base.json",
    "packages/config/**"
  ],
  "globalPassThroughEnv": [
    "CI",
    "NODE_ENV"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["src/**", "package.json", "tsconfig.json", "vite.config.ts", "prisma/schema.prisma"],
      "outputs": ["dist/**", "generated/**", ".next/**", "!.next/cache/**"],
      "env": ["VITE_*"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^build"],
      "inputs": ["src/**", "package.json", "eslint.config.js", "../../eslint.config.js"]
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "inputs": ["src/**", "package.json", "tsconfig.json", "../../packages/config/typescript/**"]
    },
    "test": {
      "dependsOn": ["build"],
      "inputs": ["src/**", "package.json", "vitest.config.ts"]
    },
    "test:contract": {
      "dependsOn": ["build"],
      "inputs": ["src/**", "package.json", "vitest.config.ts", "../../packages/types/src/schemas/**"]
    },
    "test:coverage": {
      "dependsOn": ["build"],
      "outputs": ["coverage/**"],
      "passThroughEnv": ["DATABASE_URL"]
    },
    "clean": {
      "cache": false
    },
    "test:visual": {
      "cache": false,
      "dependsOn": ["build"]
    }
  }
}
