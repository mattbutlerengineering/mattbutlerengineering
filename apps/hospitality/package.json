{
  "name": "@mbe/hospitality",
  "version": "0.0.7",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint src/ e2e/",
    "typecheck": "tsc --noEmit -p tsconfig.test.json && tsc --noEmit -p tsconfig.e2e.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "test:e2e": "playwright test --config playwright.config.ts",
    "test:journey": "playwright test --config playwright.journey.config.ts",
    "test:a11y": "playwright test --config playwright.config.ts e2e/a11y.test.ts",
    "size": "size-limit",
    "size:check": "node scripts/check-chunk-coverage.mjs && size-limit"
  },
  "size-limit": [
    {
      "name": "Hospitality App (JS)",
      "path": "dist/assets/index-*.js",
      "limit": "500 kB"
    },
    {
      "name": "Hospitality App (CSS)",
      "path": "dist/assets/index-*.css",
      "limit": "150 kB"
    },
    {
      "name": "Floor Plan Editor (lazy chunk)",
      "path": "dist/assets/FloorPlanEditorPage-*.js",
      "limit": "6 kB"
    },
    {
      "name": "Floor Plan Shared (floor-plan-* incl. any geometry split, lazy chunks)",
      "path": "dist/assets/floor-plan-*.js",
      "limit": "9 kB"
    },
    {
      "name": "Dress Rehearsal (shared by the timeline and floor plan pages)",
      "path": "dist/assets/use-rehearsal-playback-*.js",
      "limit": "4 kB"
    },
    {
      "name": "Quick Setup Form (shared by the availability page and onboarding)",
      "path": "dist/assets/QuickSetupForm-*.js",
      "limit": "8 kB"
    },
    {
      "name": "Close Dialog (shared by the availability page and the timeline's Tonight panel)",
      "path": "dist/assets/CloseDialog-*.js",
      "limit": "5.5 kB"
    },
    {
      "name": "Service-day helpers (shared by the timeline's Tonight panel and the staff waitlist/booking form)",
      "path": "dist/assets/current-service-date-*.js",
      "limit": "3.5 kB"
    },
    {
      "name": "Venue Onboarding (lazy chunk)",
      "path": "dist/assets/VenueOnboardingPage-*.js",
      "limit": "7.5 kB"
    },
    {
      "name": "Canvas Vendor (konva/react-konva, lazy chunk)",
      "path": "dist/assets/canvas-vendor-*.js",
      "limit": "100 kB"
    },
    {
      "name": "React Vendor (react/react-dom)",
      "path": "dist/assets/react-vendor-*.js",
      "limit": "64 kB"
    },
    {
      "name": "Rialto Vendor (design system)",
      "path": "dist/assets/rialto-vendor-*.js",
      "limit": "88 kB"
    },
    {
      "name": "Router Vendor (react-router)",
      "path": "dist/assets/router-vendor-*.js",
      "limit": "31 kB"
    },
    {
      "name": "JSON Render Vendor (@json-render/react)",
      "path": "dist/assets/json-render-vendor-*.js",
      "limit": "42 kB"
    },
    {
      "name": "Auth Vendor (@mbe/auth)",
      "path": "dist/assets/auth-vendor-*.js",
      "limit": "23 kB"
    },
    {
      "name": "Sentry Vendor (@sentry/*)",
      "path": "dist/assets/sentry-vendor-*.js",
      "limit": "33 kB"
    },
    {
      "name": "Quick-setup draft + legacy-hours reader (shared by onboarding and the Availability page)",
      "path": "dist/assets/quick-setup-draft-*.js",
      "limit": "8 kB"
    },
    {
      "name": "Copilot context + catalog registry (shared by dashboard drawer and chat page)",
      "path": "dist/assets/copilotContext-*.js",
      "limit": "11 kB"
    }
  ],
  "dependencies": {
    "@json-render/react": "^0.21.1",
    "@mattbutlerengineering/rialto": "workspace:*",
    "@mbe/api-client": "workspace:*",
    "@mbe/availability": "workspace:*",
    "@mbe/auth": "workspace:*",
    "@mbe/cancellation-policy": "workspace:*",
    "@mbe/rialto-catalog": "workspace:*",
    "@mbe/sentry": "workspace:*",
    "@mbe/types": "workspace:*",
    "@microsoft/fetch-event-source": "^2.0.1",
    "@stripe/react-stripe-js": "^7.0.0",
    "@stripe/stripe-js": "^10.1.0",
    "@tanstack/react-query": "^5.104.3",
    "i18next": "26.4.7",
    "idb": "^8.0.4",
    "konva": "^10.9.0",
    "qrcode": "^1.5.4",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-hook-form": "^7.90.0",
    "react-i18next": "17.0.20",
    "react-konva": "^19.3.2",
    "react-router": "catalog:"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@mbe/config": "workspace:*",
    "@mbe/ui-quality-capture": "workspace:*",
    "@playwright/test": "^1.64.1",
    "@sentry/vite-plugin": "^11.8.0",
    "@testing-library/jest-dom": "catalog:",
    "@testing-library/react": "catalog:",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "catalog:",
    "@types/qrcode": "^1.5.6",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "axe-core": "^4.14.0",
    "fake-indexeddb": "^6.2.6",
    "jsdom": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:",
    "vitest-axe": "^0.1.0",
    "zod": "^4.6.6"
  },
  "license": "MIT"
}
