{
  "name": "@mbe/hospitality",
  "version": "0.0.7",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint src/",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "test:e2e": "playwright test --config playwright.config.ts",
    "test:journey": "playwright test --config playwright.journey.config.ts",
    "test:a11y": "playwright test --config playwright.config.ts e2e/a11y.test.ts",
    "size": "size-limit",
    "size:check": "node scripts/check-vendor-chunk-coverage.mjs && size-limit"
  },
  "size-limit": [
    {
      "name": "Hospitality App (JS)",
      "path": "dist/assets/index-*.js",
      "limit": "500 kB"
    },
    {
      "name": "Hospitality App (CSS)",
      "path": "dist/assets/index-*.css",
      "limit": "150 kB"
    },
    {
      "name": "Floor Plan Editor (lazy chunk)",
      "path": "dist/assets/FloorPlanEditorPage-*.js",
      "limit": "3.5 kB"
    },
    {
      "name": "Venue Onboarding (lazy chunk)",
      "path": "dist/assets/VenueOnboardingPage-*.js",
      "limit": "7.5 kB"
    },
    {
      "name": "Canvas Vendor (konva/react-konva, lazy chunk)",
      "path": "dist/assets/canvas-vendor-*.js",
      "limit": "100 kB"
    },
    {
      "name": "React Vendor (react/react-dom)",
      "path": "dist/assets/react-vendor-*.js",
      "limit": "85 kB"
    },
    {
      "name": "Rialto Vendor (design system)",
      "path": "dist/assets/rialto-vendor-*.js",
      "limit": "72 kB"
    },
    {
      "name": "Router Vendor (react-router)",
      "path": "dist/assets/router-vendor-*.js",
      "limit": "29 kB"
    },
    {
      "name": "JSON Render Vendor (@json-render/react)",
      "path": "dist/assets/json-render-vendor-*.js",
      "limit": "30 kB"
    },
    {
      "name": "Auth Vendor (@mbe/auth)",
      "path": "dist/assets/auth-vendor-*.js",
      "limit": "21 kB"
    }
  ],
  "dependencies": {
    "@json-render/react": "^0.20.0",
    "@mattbutlerengineering/rialto": "workspace:*",
    "@mbe/api-client": "workspace:*",
    "@mbe/auth": "workspace:*",
    "@mbe/cancellation-policy": "workspace:*",
    "@mbe/observability": "workspace:*",
    "@mbe/rialto-catalog": "workspace:*",
    "@mbe/sentry": "workspace:*",
    "@mbe/types": "workspace:*",
    "@microsoft/fetch-event-source": "^2.0.1",
    "@stripe/react-stripe-js": "^6.8.2",
    "@stripe/stripe-js": "^9.14.0",
    "@tanstack/react-query": "^5.101.4",
    "idb": "^8.0.3",
    "konva": "^10.3.1",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-hook-form": "^7.85.0",
    "react-konva": "^19.2.5",
    "react-router": "catalog:"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@mbe/config": "workspace:*",
    "@playwright/test": "^1.62.1",
    "@sentry/vite-plugin": "^5.4.0",
    "@testing-library/jest-dom": "catalog:",
    "@testing-library/react": "catalog:",
    "@testing-library/user-event": "^14.6.5",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "catalog:",
    "zod": "^4.4.3"
  },
  "license": "MIT",
  "acmm": {
    "inherit": true,
    "globalPaths": [
      ".github/workflows/",
      ".github/PULL_REQUEST_TEMPLATE.md",
      ".github/pull_request_template.md",
      ".github/ISSUE_TEMPLATE/",
      ".github/policies/",
      ".github/auto-qa-tuning.json",
      ".github/risk-assessment.yml",
      ".github/labeler.yml",
      "CONTRIBUTING.md",
      "SECURITY-AI.md",
      "docs/ai-ops-runbook.md",
      "docs/rollback-drill.md",
      "docs/reflections/",
      "docs/autonomous-work-log.md",
      "scripts/acmm/",
      "scripts/build-accm-history.mjs",
      "scripts/orchestrate.mjs",
      ".claude/settings.json",
      ".claude/risk-config.json",
      "memory/",
      "knowledge.jsonl",
      "CODEOWNERS",
      ".github/CODEOWNERS",
      "risk-config.json"
    ]
  }
}
