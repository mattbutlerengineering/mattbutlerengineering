VITE_AUTH_AUTHORITY=https://your-tenant.us.auth0.com
VITE_AUTH_CLIENT_ID=your_client_id
VITE_AUTH_AUDIENCE=https://api.mattbutlerengineering.com
VITE_AUTH_REDIRECT_URI=http://localhost:3002/hospitality/callback
VITE_API_URL=

# E2E test auth (Resource Owner Password Grant)
# Auth0 app must have Password grant type enabled; test user must not have MFA
E2E_AUTH0_DOMAIN=your-tenant.us.auth0.com
E2E_AUTH0_CLIENT_ID=your_e2e_client_id
E2E_AUTH0_AUDIENCE=https://api.mattbutlerengineering.com
E2E_AUTH_EMAIL=e2e-test@example.com
E2E_AUTH_PASSWORD=your_test_password
