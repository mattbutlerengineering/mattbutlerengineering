{
  "name": "@mbe/rialto-web",
  "version": "0.0.7",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "prebuild": "cp ../../packages/rialto/registry.json public/registry.json",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test:a11y": "playwright test --config playwright.config.ts e2e/a11y.test.ts",
    "size": "size-limit",
    "size:check": "size-limit"
  },
  "size-limit": [
    {
      "name": "Rialto Web App (JS)",
      "path": "dist/assets/index-*.js",
      "limit": "700 kB"
    },
    {
      "name": "Rialto Web App (CSS)",
      "path": "dist/assets/index-*.css",
      "limit": "30 kB"
    }
  ],
  "dependencies": {
    "@mattbutlerengineering/rialto": "workspace:*",
    "@mbe/sentry": "workspace:^",
    "framer-motion": "catalog:",
    "lucide-react": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-router-dom": "catalog:"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.2",
    "@mbe/config": "workspace:*",
    "@playwright/test": "^1.59.1",
    "@sentry/vite-plugin": "^5.2.0",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:"
  },
  "license": "MIT",
  "acmm": {
    "inherit": true,
    "globalPaths": [
      ".github/workflows/",
      ".github/PULL_REQUEST_TEMPLATE.md",
      ".github/pull_request_template.md",
      ".github/ISSUE_TEMPLATE/",
      ".github/policies/",
      ".github/auto-qa-tuning.json",
      ".github/risk-assessment.yml",
      ".github/labeler.yml",
      "CONTRIBUTING.md",
      "SECURITY-AI.md",
      "docs/ai-ops-runbook.md",
      "docs/rollback-drill.md",
      "docs/reflections/",
      "docs/autonomous-work-log.md",
      "scripts/acmm/",
      "scripts/build-accm-history.mjs",
      "scripts/orchestrate.mjs",
      ".claude/settings.json",
      ".claude/risk-config.json",
      "memory/",
      "knowledge.jsonl",
      "CODEOWNERS",
      ".github/CODEOWNERS",
      "risk-config.json"
    ]
  }
}
