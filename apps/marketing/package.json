{
  "name": "@mbe/marketing",
  "version": "0.0.7",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint src/ e2e/",
    "typecheck": "NODE_OPTIONS=--max-old-space-size=8192 tsc --noEmit && tsc --noEmit -p tsconfig.e2e.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "test:a11y": "playwright test --config playwright.config.ts e2e/a11y.test.ts",
    "test:e2e": "playwright test --config playwright.config.ts",
    "size": "size-limit",
    "size:check": "size-limit"
  },
  "size-limit": [
    {
      "name": "Marketing App (JS)",
      "path": "dist/assets/index-*.js",
      "limit": "750 kB"
    },
    {
      "name": "Marketing App (CSS)",
      "path": "dist/assets/index-*.css",
      "limit": "50 kB"
    },
    {
      "name": "Factory Scene (lazy chunk)",
      "path": "dist/assets/factory-scene-*.js",
      "limit": "130 kB"
    },
    {
      "name": "React Vendor",
      "path": "dist/assets/vendor-react-*.js",
      "limit": "80 kB"
    },
    {
      "name": "Motion Vendor",
      "path": "dist/assets/vendor-motion-*.js",
      "limit": "52 kB"
    },
    {
      "name": "Shipped Features (lazy chunk)",
      "path": "dist/assets/shipped-features-*.js",
      "limit": "32 kB"
    }
  ],
  "dependencies": {
    "@mattbutlerengineering/rialto": "workspace:*",
    "@tanstack/react-query": "^5.104.5",
    "framer-motion": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-router": "catalog:",
    "@mbe/sentry": "workspace:*",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@mbe/config": "workspace:*",
    "@mbe/ui-quality-capture": "workspace:*",
    "@playwright/test": "^1.64.1",
    "@sentry/vite-plugin": "^11.9.0",
    "@testing-library/jest-dom": "catalog:",
    "@testing-library/react": "catalog:",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "jsdom": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "catalog:"
  },
  "depcheck": {
    "ignores": [
      "@gen/hooks"
    ]
  },
  "license": "MIT"
}
