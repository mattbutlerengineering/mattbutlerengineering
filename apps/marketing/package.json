{
  "name": "@mbe/marketing",
  "version": "0.0.6",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint src/",
    "typecheck": "tsc --noEmit",
    "test:a11y": "playwright test --config playwright.config.ts e2e/a11y.test.ts",
    "size": "size-limit",
    "size:check": "size-limit"
  },
  "size-limit": [
    {
      "name": "Marketing App (JS)",
      "path": "dist/assets/index-*.js",
      "limit": "750 kB"
    },
    {
      "name": "Marketing App (CSS)",
      "path": "dist/assets/index-*.css",
      "limit": "50 kB"
    }
  ],
  "dependencies": {
    "@mattbutlerengineering/rialto": "workspace:*",
    "@mbe/sentry": "workspace:^",
    "framer-motion": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-router-dom": "catalog:"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.2",
    "@mbe/config": "workspace:*",
    "@playwright/test": "^1.59.1",
    "@sentry/vite-plugin": "^5.2.0",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:"
  },
  "license": "MIT"
}
