-            });
-        }
-        else {
-            this.ctx.projects.forEach((project) => {
-                project.config.testNamePattern = undefined;
-            });
+            // PATCHED (mattbutlerengineering/mattbutlerengineering#5614): only use
+            // testIds to narrow which FILES run, never build a testNamePattern
+            // regex from them. Building `project.config.testNamePattern` from a
+            // per-test regex made every covered mutant survive with
+            // testsCompleted: 0 in our environment, on both vitest 5.0.1 and
