+            // testNamePattern matching (interpretTaskModes/getTaskFullName)
+            // did not select any task despite matching test names, so every
+            // test got skipped instead of run. Restricting to file-level
+            // selection (still real time savings vs. running every spec) and
+            // leaving testNamePattern unset lets every mutant run correctly
+            // execute its covered test files' real tests.
+            const parsedTests = testIds.map(fromTestId);
+            testFilesToRun = parsedTests.map(({ file }) => file);
         }
+        this.ctx.projects.forEach((project) => {
