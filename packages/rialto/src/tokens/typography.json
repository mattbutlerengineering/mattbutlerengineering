{
  "font": {
    "family": {
      "sans": {
        "$value": "'DM Sans', 'Untitled Sans', system-ui, 'Segoe UI', sans-serif",
        "$type": "fontFamily"
      },
      "mono": {
        "$value": "'DM Mono', ui-monospace, monospace",
        "$type": "fontFamily"
      }
    },
    "weight": {
      "light": {
        "$value": 300,
        "$type": "fontWeight"
      },
      "book": {
        "$value": 350,
        "$type": "fontWeight",
        "$description": "Variable font only — between light and regular"
      },
      "regular": {
        "$value": 400,
        "$type": "fontWeight"
      },
      "demi": {
        "$value": 450,
        "$type": "fontWeight",
        "$description": "Variable font only — between regular and medium"
      },
      "medium": {
        "$value": 500,
        "$type": "fontWeight"
      }
    },
    "size": {
      "xs": {
        "$value": "0.694rem",
        "$type": "dimension",
        "$description": "~11px - Badges, fine print"
      },
      "sm": {
        "$value": "0.833rem",
        "$type": "dimension",
        "$description": "~13px - Captions, helper text"
      },
      "base": {
        "$value": "1rem",
        "$type": "dimension",
        "$description": "16px - Body text"
      },
      "md": {
        "$value": "1.2rem",
        "$type": "dimension",
        "$description": "~19px - Subheadings"
      },
      "lg": {
        "$value": "1.44rem",
        "$type": "dimension",
        "$description": "~23px - Section headings"
      },
      "xl": {
        "$value": "1.728rem",
        "$type": "dimension",
        "$description": "~28px - Page headings"
      },
      "2xl": {
        "$value": "2.074rem",
        "$type": "dimension",
        "$description": "~33px - Major headings"
      },
      "3xl": {
        "$value": "2.986rem",
        "$type": "dimension",
        "$description": "~48px - Hero display"
      },
      "4xl": {
        "$value": "4.3rem",
        "$type": "dimension",
        "$description": "~69px - Dramatic display"
      }
    },
    "line-height": {
      "tight": {
        "$value": 1.2,
        "$type": "number"
      },
      "normal": {
        "$value": 1.5,
        "$type": "number"
      },
      "relaxed": {
        "$value": 1.65,
        "$type": "number"
      }
    },
    "letter-spacing": {
      "tight": {
        "$value": "-0.02em",
        "$type": "dimension"
      },
      "normal": {
        "$value": 0,
        "$type": "dimension"
      },
      "wide": {
        "$value": "0.04em",
        "$type": "dimension"
      }
    },
    "optical-size": {
      "$description": "Variable font optical sizing — controls letterform detail at different sizes",
      "12": { "$value": 12, "$type": "number" },
      "14": { "$value": 14, "$type": "number" },
      "16": { "$value": 16, "$type": "number" },
      "20": { "$value": 20, "$type": "number" },
      "24": { "$value": 24, "$type": "number" },
      "32": { "$value": 32, "$type": "number" },
      "48": { "$value": 48, "$type": "number" },
      "72": { "$value": 72, "$type": "number" }
    }
  }
}
