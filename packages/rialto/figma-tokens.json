          "$type": "color",
          "$description": "Cards, popovers, elevated containers"
        },
        "recessed": {
          "$value": "#edeae5",
          "$type": "color",
          "$description": "Input fields, slider tracks, recessed channels"
        },
        "matte": {
          "$value": "#d8d4cd",
