        "glow": {
          "$value": "rgb(176 132 30 / 0.35)",
          "$type": "color",
          "$description": "Focus ring outer glow"
        }
      },
      "semantic": {
        "error": {
          "default": {
            "$value": "#b84a3c",
            "$type": "color",
            "$description": "Error text, destructive button fills"
          },
          "muted": {
            "$value": "rgb(184 74 60 / 0.1)",
            "$type": "color",
            "$description": "Error alert backgrounds"
          }
        },
        "warning": {
          "default": {
            "$value": "#8a6820",
            "$type": "color",
            "$description": "Warning text, caution banners, pending states"
          },
          "muted": {
            "$value": "rgb(138 104 32 / 0.1)",
            "$type": "color",
            "$description": "Warning alert backgrounds, warning badge tints"
          }
        },
        "success": {
          "default": {
            "$value": "#5e6a2e",
            "$type": "color",
            "$description": "Success text, confirmation icons"
          },
          "muted": {
            "$value": "rgb(94 106 46 / 0.1)",
            "$type": "color",
            "$description": "Success alert backgrounds"
          }
        }
      },
      "overlay": {
        "$value": "rgb(26 25 24 / 0.4)",
        "$type": "color",
        "$description": "Modal/drawer backdrop"
      }
    },
    "shadow": {
      "xs": {
        "$value": "0 1px 2px rgb(26 25 24 / 0.05)",
        "$type": "shadow",
        "$description": "Subtle lift — buttons at rest, tags, badges"
      },
      "sm": {
        "$value": "0 1px 2px rgb(26 25 24 / 0.06), 0 4px 12px rgb(26 25 24 / 0.08)",
        "$type": "shadow",
        "$description": "Standard elevation — cards, dropdowns"
      },
      "md": {
        "$value": "0 2px 4px rgb(26 25 24 / 0.06), 0 8px 24px rgb(26 25 24 / 0.1)",
        "$type": "shadow",
        "$description": "Pronounced elevation — hovered cards, active dropdowns"
      },
      "lg": {
        "$value": "0 4px 8px rgb(26 25 24 / 0.06), 0 12px 40px rgb(26 25 24 / 0.12), 0 24px 64px rgb(26 25 24 / 0.06)",
        "$type": "shadow",
        "$description": "Dramatic elevation — modals, command palette, floating panels"
      },
      "pressed": {
        "$value": "inset 0 1px 3px rgb(26 25 24 / 0.15), inset 0 0 1px rgb(26 25 24 / 0.1)",
        "$type": "shadow",
        "$description": "Recessed inputs, slider tracks, toggle tracks, active button press"
      },
      "focus": {
        "$value": "0 0 0 2px var(--rialto-surface), 0 0 0 4px var(--rialto-accent), 0 0 12px var(--rialto-accent-glow)",
        "$type": "shadow",
        "$description": "Focus-visible state for all interactive elements"
      },
      "glass": {
        "$value": "0 2px 8px rgb(26 25 24 / 0.05), 0 8px 32px rgb(26 25 24 / 0.1), inset 0 0.5px 0 rgb(255 255 255 / 0.3)",
        "$type": "shadow",
        "$description": "Floating panels, command palette, frosted-glass overlays"
      },
      "ambient": {
        "$value": "0 0 20px rgb(196 146 42 / 0.08), 0 0 40px rgb(196 146 42 / 0.04)",
        "$type": "shadow",
        "$description": "Subtle gold luminosity for primary CTAs, active selections, and elevated interactive elements that should \"breathe\" warmth"
      },
      "luminous": {
        "$value": "0 2px 4px rgb(26 25 24 / 0.06), 0 8px 24px rgb(26 25 24 / 0.08), 0 0 32px rgb(196 146 42 / 0.06)",
        "$type": "shadow",
        "$description": "Cards and panels that should feel lit from within. Combines standard elevation with warm ambient bloom."
      }
    }
  },
