        "dist/lib/chunks/Autocomplete-*.js"
      ],
      "limit": "2000 B"
    },
    {
      "name": "CommandPalette (subpath)",
      "path": [
        "dist/lib/components/CommandPalette/index.js",
        "dist/lib/chunks/CommandPalette-*.js"
      ],
      "limit": "2650 B"
    },
    {
      "name": "Ferrofluid (subpath)",
      "path": [
        "dist/lib/components/Ferrofluid/index.js",
        "dist/lib/chunks/Ferrofluid-*.js"
      ],
      "limit": "1150 B"
    },
    {
      "name": "FlipDot (subpath)",
      "path": [
        "dist/lib/components/FlipDot/index.js",
        "dist/lib/chunks/use-flip-dot-animation-*.js"
      ],
      "limit": "3700 B"
    }
  ],
