  "size-limit": [
    {
      "name": "JS (all components)",
      "path": "dist/lib/rialto.js",
      "limit": "150 kB"
    },
    {
      "name": "CSS (all styles)",
      "path": "dist/lib/styles.css",
      "limit": "120 kB"
    },
    {
      "name": "Motion tokens",
      "path": "dist/lib/motion.js",
      "limit": "1 kB"
    },
    {
      "name": "Button (subpath)",
      "path": [
        "dist/lib/components/Button/index.js",
        "dist/lib/chunks/Button-*.js"
      ],
      "limit": "900 B"
    },
    {
      "name": "Card (subpath)",
      "path": [
        "dist/lib/components/Card/index.js",
        "dist/lib/chunks/Card-*.js"
      ],
      "limit": "800 B"
    },
    {
      "name": "Dialog (subpath)",
