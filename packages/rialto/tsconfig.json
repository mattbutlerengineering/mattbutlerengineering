{
  "extends": "@mbe/config/typescript/react",
  "compilerOptions": {
    "outDir": "dist",
    "rootDir": "src",
    "noUncheckedIndexedAccess": true,
    "useDefineForClassFields": true,
    "moduleDetection": "force",
    "allowImportingTsExtensions": true,
    "types": ["vitest/globals"]
  },
  "include": ["src"]
}
