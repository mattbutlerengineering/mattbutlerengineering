{
  "name": "@mbe/types",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "production": "./dist/index.js",
      "default": "./src/index.ts"
    },
    "./api": {
      "types": "./src/api.ts",
      "production": "./dist/api.js",
      "default": "./src/api.ts"
    },
    "./user": {
      "types": "./src/user.ts",
      "production": "./dist/user.js",
      "default": "./src/user.ts"
    },
    "./agent": {
      "types": "./src/agent.ts",
      "production": "./dist/agent.js",
      "default": "./src/agent.ts"
    },
    "./schema-compat": {
      "types": "./src/schema-compat.ts",
      "production": "./dist/schema-compat.js",
      "default": "./src/schema-compat.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "lint": "eslint src/",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@mbe/config": "workspace:*",
    "typescript": "catalog:"
  },
  "dependencies": {
    "zod": "catalog:"
  }
}
