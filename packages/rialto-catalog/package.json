{
  "name": "@mbe/rialto-catalog",
  "version": "0.1.7",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "production": "./dist/index.js",
      "default": "./src/index.ts"
    },
    "./catalog": {
      "types": "./src/catalog.ts",
      "production": "./dist/catalog.js",
      "default": "./src/catalog.ts"
    }
  },
  "scripts": {
    "generate": "tsx scripts/generate-catalog.ts",
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:drift": "vitest run src/__tests__/drift-check.test.ts",
    "typecheck": "tsc --noEmit",
    "size": "size-limit",
    "size:check": "size-limit"
  },
  "dependencies": {
    "@json-render/core": "^0.19.0",
    "@json-render/react": "^0.19.0",
    "@mattbutlerengineering/rialto": "workspace:*",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@mbe/config": "workspace:*",
    "@testing-library/react": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "tsx": "^4.23.12",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "size-limit": [
    {
      "name": "index (subpath)",
      "path": "dist/index.js",
      "limit": "120 B"
    },
    {
      "name": "catalog (subpath)",
      "path": "dist/catalog.js",
      "limit": "800 B"
    }
  ],
  "license": "MIT"
}
