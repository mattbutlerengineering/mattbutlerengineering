{
  "name": "@mbe/api-client",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "production": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./users": {
      "types": "./src/users.ts",
      "production": "./dist/users.js",
      "default": "./dist/users.js"
    },
    "./streaming": {
      "types": "./src/streaming.ts",
      "production": "./dist/streaming.js",
      "default": "./dist/streaming.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "lint": "eslint src/",
    "typecheck": "tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:contract": "vitest run src/contract.test.ts",
    "test:watch": "vitest",
    "size": "size-limit",
    "size:check": "size-limit"
  },
  "dependencies": {
    "@mbe/types": "workspace:*",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@mbe/config": "workspace:*",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "size-limit": [
    {
      "name": "index (subpath)",
      "path": "dist/index.js",
      "limit": "650 B"
    },
    {
      "name": "users (subpath)",
      "path": "dist/users.js",
      "limit": "460 B"
    },
    {
      "name": "streaming (subpath)",
      "path": "dist/streaming.js",
      "limit": "1000 B"
    }
  ],
  "license": "MIT"
}
