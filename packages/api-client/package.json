{
  "name": "@mbe/api-client",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "production": "./dist/index.js",
      "default": "./src/index.ts"
    },
    "./users": {
      "types": "./src/users.ts",
      "production": "./dist/users.js",
      "default": "./src/users.ts"
    },
    "./streaming": {
      "types": "./src/streaming.ts",
      "production": "./dist/streaming.js",
      "default": "./src/streaming.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "lint": "eslint src/",
    "typecheck": "tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:contract": "vitest run src/contract.test.ts",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@mbe/types": "workspace:*",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@mbe/config": "workspace:*",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "license": "MIT"
}
