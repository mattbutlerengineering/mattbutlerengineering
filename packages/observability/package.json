{
  "name": "@mbe/observability",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./build-info": {
      "types": "./src/build-info.ts",
      "production": "./dist/build-info.js",
      "default": "./src/build-info.ts"
    },
    ".": {
      "types": "./src/index.ts",
      "production": "./dist/index.js",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "lint": "eslint src/",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "fastify": "catalog:"
  },
  "peerDependenciesMeta": {
    "fastify": {
      "optional": true
    }
  },
  "dependencies": {
    "@fastify/otel": "^0.21.1",
    "@langfuse/otel": "^5.13.0",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/exporter-metrics-otlp-http": "^0.223.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.223.0",
    "@opentelemetry/instrumentation-http": "^0.223.0",
    "@opentelemetry/instrumentation-pino": "^0.69.0",
    "@opentelemetry/resources": "^2.12.0",
    "@opentelemetry/sdk-metrics": "^2.12.0",
    "@opentelemetry/sdk-node": "^0.223.0",
    "@opentelemetry/sdk-trace-base": "^2.12.0",
    "@opentelemetry/semantic-conventions": "^1.43.0",
    "fastify": "catalog:",
    "fastify-plugin": "^6.0.1"
  },
  "devDependencies": {
    "@mbe/config": "workspace:*",
    "@mbe/database": "workspace:*",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "license": "MIT"
}
