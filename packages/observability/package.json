{
  "name": "@mbe/observability",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "production": "./dist/index.js",
      "default": "./src/index.ts"
    },
    "./baggage": {
      "types": "./src/baggage.ts",
      "production": "./dist/baggage.js",
      "default": "./src/baggage.ts"
    },
    "./sentry": {
      "types": "./src/sentry/index.ts",
      "production": "./dist/sentry/index.js",
      "default": "./src/sentry/index.ts"
    },
    "./sentry/node": {
      "types": "./src/sentry/node.ts",
      "production": "./dist/sentry/node.js",
      "default": "./src/sentry/node.ts"
    },
    "./sentry/react": {
      "types": "./src/sentry/react.ts",
      "production": "./dist/sentry/react.js",
      "default": "./src/sentry/react.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "lint": "eslint src/",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "fastify": "catalog:",
    "react": "catalog:"
  },
  "peerDependenciesMeta": {
    "fastify": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "dependencies": {
    "@langfuse/otel": "^5.3.0",
    "@mbe/types": "workspace:^",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/exporter-metrics-otlp-http": "^0.217.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.217.0",
    "@opentelemetry/instrumentation-fastify": "^0.57.0",
    "@opentelemetry/instrumentation-http": "^0.217.0",
    "@opentelemetry/instrumentation-pino": "^0.63.0",
    "@opentelemetry/resources": "^2.7.1",
    "@opentelemetry/sdk-metrics": "^2.7.1",
    "@opentelemetry/sdk-node": "^0.217.0",
    "@opentelemetry/sdk-trace-base": "^2.7.1",
    "@opentelemetry/semantic-conventions": "^1.40.0",
    "@sentry/node": "^10.52.0",
    "@sentry/react": "^10.52.0",
    "fastify": "catalog:",
    "fastify-plugin": "^5.0.0",
    "langfuse": "^3.38.20"
  },
  "devDependencies": {
    "@mbe/config": "workspace:*",
    "@types/react": "catalog:",
    "react": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "license": "MIT"
}
