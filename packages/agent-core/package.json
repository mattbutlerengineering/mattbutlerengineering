{
  "name": "@mbe/agent-core",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./testing": {
      "types": "./src/testing/index.ts",
      "production": "./dist/testing/index.js",
      "default": "./src/testing/index.ts"
    },
    ".": {
      "types": "./src/index.ts",
      "production": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "lint": "eslint src/",
    "typecheck": "tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.309",
    "@langfuse/tracing": "^6.0.2",
    "@mbe/api-client": "workspace:*",
    "@mbe/types": "workspace:*",
    "@opentelemetry/api": "^1.10.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@mbe/config": "workspace:*",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "license": "MIT"
}
