{
  "name": "@mbe/auth",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "production": "./dist/index.js",
      "default": "./src/index.ts"
    },
    "./react": {
      "types": "./src/react/index.ts",
      "production": "./dist/react/index.js",
      "default": "./src/react/index.ts"
    },
    "./fastify": {
      "types": "./src/fastify/index.ts",
      "production": "./dist/fastify/index.js",
      "default": "./src/fastify/index.ts"
    },
    "./types": {
      "types": "./src/types/index.ts",
      "production": "./dist/types/index.js",
      "default": "./src/types/index.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src/",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "fastify": "^5.8.3",
    "react": "^19.0.0"
  },
  "peerDependenciesMeta": {
    "fastify": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "dependencies": {
    "@mbe/types": "workspace:^",
    "fastify-plugin": "^5.0.0",
    "jose": "^6.2.2",
    "oidc-client-ts": "^3.5.0",
    "react-oidc-context": "^3.3.1"
  },
  "devDependencies": {
    "@mbe/config": "workspace:*",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "fastify": "catalog:",
    "react": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "license": "MIT"
}
