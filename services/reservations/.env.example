# Database
DATABASE_URL="postgresql://mbe:mbe_dev_password@localhost:5432/mbe?schema=public"

# Server
PORT=3004
HOST=0.0.0.0
LOG_LEVEL=info

# API Documentation (optional - for OpenAPI server URL in production)
# API_BASE_URL=https://mattbutlerengineering.com/api

# CORS
CORS_ORIGINS=http://localhost:3000

# Auth
AUTH_AUTHORITY=https://your-tenant.auth0.com
AUTH_AUDIENCE=https://api.mattbutlerengineering.com

# Guest self-service manage page
# MANAGE_TOKEN_SECRET=change-me-in-production

# Email notifications (optional — omit to disable)
# RESEND_API_KEY=re_xxxxxxxxxxxx
# EMAIL_FROM=reservations@mattbutlerengineering.com
# MANAGE_BASE_URL=https://mattbutlerengineering.com
# UNSUBSCRIBE_SECRET=change-me-in-production

# Redis (optional — used for booking notification scheduling)
# REDIS_URL=redis://localhost:6379

# Stripe (optional — omit to disable deposit collection)
# STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Sentry (optional — omit to disable error tracking)
# SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
