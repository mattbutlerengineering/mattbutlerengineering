# Database
DATABASE_URL="postgresql://mbe:mbe_dev_password@localhost:5432/mbe?schema=public"

# Prisma connection pool size (optional — default: 5)
# PRISMA_CONNECTION_LIMIT=5

# Server
PORT=3004
HOST=0.0.0.0
LOG_LEVEL=info

# API Documentation (optional - for OpenAPI server URL in production)
# API_BASE_URL=https://mattbutlerengineering.com/api

# CORS
CORS_ORIGINS=http://localhost:3000

# Auth
AUTH_AUTHORITY=https://your-tenant.auth0.com
AUTH_AUDIENCE=https://api.mattbutlerengineering.com
# Auth0 JWKS endpoint override (optional). Unset: derived from AUTH_AUTHORITY,
# with a dev-tenant fallback outside production. Consulted by the /ready health check.
# AUTH0_JWKS_URL=https://your-tenant.auth0.com/.well-known/jwks.json
# Test-only auth bypass (NEVER set in production): when "true" AND NODE_ENV=test,
# requests opting in via the bypass header skip JWT validation and receive a
# hardcoded admin identity. Unset, or NODE_ENV != test: bypass never activates.
# AUTH_BYPASS_IN_TESTS=true

# Guest self-service manage page (REQUIRED in production — use a strong random secret)
MANAGE_TOKEN_SECRET=change-me-in-prod

# Post-visit email unsubscribe tokens
# UNSUBSCRIBE_TOKEN_SECRET=change-me-in-production

# Email notifications (optional — omit to disable)
# RESEND_API_KEY=re_xxxxxxxxxxxx
# EMAIL_FROM=reservations@mattbutlerengineering.com
# MANAGE_BASE_URL=https://mattbutlerengineering.com

# SMS notifications via Twilio (optional — omit to disable)
# TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_FROM_NUMBER=+15555555555

# Redis (optional — used for booking notification scheduling)
# REDIS_URL=redis://localhost:6379

# Stripe (optional — omit to disable deposit collection)
# STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Sentry (optional — omit to disable error tracking)
# SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
# Sentry environment tag (optional — unset falls back to NODE_ENV)
# SENTRY_ENVIRONMENT=production

# Observability (OpenTelemetry / Langfuse)
# Disables the OTel SDK entirely when "true" (e.g. in tests). Unset: enabled.
# OTEL_SDK_DISABLED=false
# Enables Langfuse trace export (optional — also needs LANGFUSE_SECRET_KEY).
# Unset: Langfuse export is skipped, zero overhead.
# LANGFUSE_PUBLIC_KEY=pk-lf-...
