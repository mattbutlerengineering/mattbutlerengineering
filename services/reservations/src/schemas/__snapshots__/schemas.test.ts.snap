exports[`Reservation service schemas > ReservationSchema matches snapshot 1`] = `
{
  "$id": "Reservation",
  "description": "A reservation for a table",
  "properties": {
    "cancellationNote": {
      "description": "Additional cancellation notes",
      "example": "Guest did not arrive",
      "nullable": true,
      "type": "string",
    },
    "cancellationReason": {
      "description": "Reason for cancellation",
      "example": "no_show",
      "nullable": true,
      "type": "string",
    },
    "createdAt": {
      "description": "Timestamp when the reservation was created",
      "example": "2024-01-15T10:30:00.000Z",
      "format": "date-time",
      "type": "string",
    },
    "date": {
      "description": "Reservation date (YYYY-MM-DD)",
      "example": "2024-02-15",
      "format": "date",
      "type": "string",
    },
    "endTime": {
      "description": "Reservation end time",
      "example": "2024-02-15T20:00:00.000Z",
      "format": "date-time",
      "type": "string",
    },
    "guestEmail": {
      "description": "Guest email",
      "example": "john@example.com",
      "format": "email",
      "nullable": true,
      "type": "string",
    },
    "guestName": {
      "description": "Guest name (for unauthenticated reservations)",
      "example": "John Doe",
      "nullable": true,
      "type": "string",
    },
    "guestPhone": {
      "description": "Guest phone number",
      "example": "+1-555-123-4567",
      "nullable": true,
      "type": "string",
    },
    "id": {
      "description": "Unique identifier for the reservation",
      "example": "clx1234567890abcdef",
      "type": "string",
    },
    "notes": {
      "description": "Special requests or notes",
      "example": "Birthday celebration, need high chair",
      "nullable": true,
      "type": "string",
    },
    "partySize": {
      "description": "Number of guests",
      "example": 4,
      "type": "integer",
    },
    "startTime": {
      "description": "Reservation start time",
      "example": "2024-02-15T18:00:00.000Z",
      "format": "date-time",
      "type": "string",
    },
    "status": {
      "description": "Current reservation status",
      "enum": [
        "PENDING",
        "CONFIRMED",
        "CANCELLED",
        "COMPLETED",
        "NO_SHOW",
      ],
      "example": "CONFIRMED",
      "type": "string",
    },
    "table": {
      "$ref": "Table#",
      "description": "The reserved table (included when fetching reservations)",
    },
    "tableId": {
      "description": "ID of the reserved table",
      "example": "clx1234567890abcdef",
      "type": "string",
    },
    "updatedAt": {
      "description": "Timestamp when the reservation was last updated",
