exports[`Reservation service schemas > VenueSchema matches snapshot 1`] = `
{
  "$id": "Venue",
  "description": "A venue (restaurant, bar, etc.) that accepts reservations",
  "properties": {
    "createdAt": {
      "description": "Timestamp when the venue was created",
      "example": "2024-01-15T10:30:00.000Z",
      "format": "date-time",
      "type": "string",
    },
    "currencyCode": {
      "description": "ISO 4217 currency code",
      "example": "USD",
      "type": "string",
    },
    "daySchedule": {
      "properties": {
        "close": {
          "example": "22:00",
          "type": "string",
        },
        "closed": {
          "type": "boolean",
        },
        "open": {
          "example": "09:00",
          "type": "string",
        },
      },
      "type": "object",
    },
    "ianaTimezone": {
      "description": "IANA timezone identifier",
      "example": "America/Los_Angeles",
      "type": "string",
    },
    "id": {
      "description": "Unique identifier for the venue",
      "example": "clx1234567890abcdef",
      "type": "string",
    },
    "name": {
      "description": "Venue name",
      "example": "Chez Panisse",
      "type": "string",
    },
    "operatingHours": {
      "description": "Weekly operating schedule",
      "nullable": true,
      "properties": {
        "friday": {
          "$ref": "#/properties/daySchedule",
        },
        "monday": {
          "$ref": "#/properties/daySchedule",
        },
        "saturday": {
          "$ref": "#/properties/daySchedule",
        },
        "sunday": {
          "$ref": "#/properties/daySchedule",
        },
        "thursday": {
          "$ref": "#/properties/daySchedule",
        },
        "tuesday": {
          "$ref": "#/properties/daySchedule",
        },
        "wednesday": {
          "$ref": "#/properties/daySchedule",
        },
      },
      "type": "object",
    },
    "settings": {
      "description": "Venue-specific settings and feature flags",
      "nullable": true,
      "type": "object",
    },
    "slug": {
      "description": "URL-friendly identifier for public booking URLs",
      "example": "chez-panisse",
      "type": "string",
    },
    "updatedAt": {
      "description": "Timestamp when the venue was last updated",
      "example": "2024-01-20T14:45:00.000Z",
      "format": "date-time",
      "type": "string",
    },
    "venueGroup": {
