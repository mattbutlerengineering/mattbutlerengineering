      "format": "date-time",
      "type": "string",
    },
    "userId": {
      "description": "User ID (for authenticated reservations)",
      "example": "auth0|user123",
      "nullable": true,
      "type": "string",
    },
    "venueId": {
      "description": "ID of the venue for this reservation (denormalized for queries)",
      "example": "venue-123",
      "nullable": true,
      "type": "string",
    },
  },
  "required": [
    "id",
    "date",
    "startTime",
    "endTime",
    "partySize",
    "status",
    "tableId",
    "createdAt",
    "updatedAt",
  ],
  "type": "object",
}
`;

exports[`Reservation service schemas > TableSchema matches snapshot 1`] = `
{
  "$id": "Table",
  "description": "A table available for reservations",
  "properties": {
    "capacity": {
      "description": "Maximum number of guests the table can seat",
      "example": 4,
      "type": "integer",
    },
    "createdAt": {
      "description": "Timestamp when the table was created",
      "example": "2024-01-15T10:30:00.000Z",
      "format": "date-time",
      "type": "string",
    },
    "floorPlanId": {
      "description": "ID of the floor plan this table is placed on",
      "example": "floor-plan-123",
      "nullable": true,
      "type": "string",
    },
    "id": {
      "description": "Unique identifier for the table",
      "example": "clx1234567890abcdef",
      "type": "string",
    },
    "isActive": {
      "description": "Whether the table is active and available for reservations",
      "example": true,
      "type": "boolean",
    },
    "location": {
      "description": "Location description",
      "example": "Main Floor",
      "nullable": true,
      "type": "string",
    },
    "maxCovers": {
      "description": "Maximum party size (null means same as capacity)",
      "example": 6,
      "nullable": true,
      "type": "integer",
    },
    "minCovers": {
      "description": "Minimum party size for this table",
      "example": 1,
      "type": "integer",
    },
    "name": {
      "description": "Table name or number",
      "example": "Table 1",
      "type": "string",
    },
    "priority": {
      "description": "Priority for auto-assignment (higher = preferred)",
      "example": 0,
      "type": "integer",
    },
    "shapeMetadata": {
      "description": "Position and shape on the floor plan canvas",
      "oneOf": [
        {
          "$ref": "TableShapeMetadata#",
        },
        {
          "type": "null",
        },
      ],
    },
    "status": {
      "description": "Current operational status of the table",
      "enum": [
        "AVAILABLE",
        "OCCUPIED",
        "DIRTY",
        "READY",
      ],
      "example": "AVAILABLE",
      "type": "string",
    },
    "tableNumber": {
      "description": "Human-readable table number (e.g., '41', '42B')",
      "example": "41",
      "nullable": true,
      "type": "string",
    },
    "updatedAt": {
      "description": "Timestamp when the table was last updated",
      "example": "2024-01-20T14:45:00.000Z",
      "format": "date-time",
      "type": "string",
    },
    "venueId": {
      "description": "ID of the venue this table belongs to",
      "example": "venue-123",
      "nullable": true,
      "type": "string",
    },
  },
  "required": [
    "id",
    "name",
    "capacity",
    "minCovers",
    "isActive",
    "priority",
    "createdAt",
    "updatedAt",
  ],
  "type": "object",
}
`;

