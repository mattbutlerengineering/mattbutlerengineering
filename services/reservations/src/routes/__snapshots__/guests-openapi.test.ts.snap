                  "type": "string",
                },
                "phone": {
                  "description": "Guest phone",
                  "type": "string",
                },
                "tags": {
                  "description": "Tags for categorization",
                  "items": {
                    "type": "string",
                  },
                  "type": "array",
                },
                "venueId": {
                  "description": "Venue ID",
                  "type": "string",
                },
              },
              "required": [
                "venueId",
                "name",
              ],
              "type": "object",
            },
          },
        },
        "required": true,
      },
      "responses": {
