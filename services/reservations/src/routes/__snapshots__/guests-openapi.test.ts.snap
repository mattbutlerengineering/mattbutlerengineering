{
  "/api/v1/guests/": {
    "get": {
      "description": "Retrieve a paginated list of guests for a specific venue. Requires authentication.",
      "operationId": "listGuests",
      "parameters": [
        {
          "description": "Venue ID to list guests for",
          "in": "query",
          "name": "venueId",
          "required": true,
          "schema": {
            "type": "string",
          },
        },
        {
          "description": "Page number (1-indexed)",
          "in": "query",
          "name": "page",
          "required": true,
          "schema": {
            "default": "1",
            "type": "string",
          },
        },
        {
          "description": "Number of guests per page (max 100)",
          "in": "query",
          "name": "limit",
          "required": true,
          "schema": {
            "default": "10",
            "type": "string",
          },
        },
      ],
      "responses": {
        "200": {
          "content": {
            "application/json": {
              "schema": {
                "description": "Successful response with paginated guest list",
                "properties": {
                  "data": {
                    "items": {
                      "$ref": "#/components/schemas/def-7",
                    },
                    "type": "array",
                  },
                  "pagination": {
                    "properties": {
                      "hasNext": {
                        "type": "boolean",
                      },
                      "hasPrev": {
                        "type": "boolean",
                      },
                      "limit": {
                        "type": "number",
                      },
                      "page": {
                        "type": "number",
                      },
                      "total": {
                        "type": "number",
                      },
                      "totalPages": {
                        "type": "number",
                      },
                    },
                    "type": "object",
                  },
                },
                "type": "object",
              },
