  "/api/v1/guests/lapsing": {
    "get": {
      "description": "Run lapse detection and return guests who haven't visited in > 2x their average frequency.",
      "operationId": "getLapsingGuests",
      "parameters": [
        {
          "description": "Venue ID to scan",
          "in": "query",
          "name": "venueId",
