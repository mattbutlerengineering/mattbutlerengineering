                            "sms_only",
                            "both",
                            "transactional_only",
                          ],
                          "type": "string",
                        },
                        "daysOverdue": {
                          "type": "number",
                        },
                        "daysSinceLastVisit": {
                          "type": "number",
                        },
                        "email": {
                          "nullable": true,
                          "type": "string",
                        },
                        "guestId": {
                          "type": "string",
                        },
                        "name": {
                          "type": "string",
                        },
                        "phone": {
                          "nullable": true,
                          "type": "string",
                        },
                      },
                      "type": "object",
