generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ReservationStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
  NO_SHOW
}

enum Occasion {
  birthday
  anniversary
  business
  date_night
  other
  none
}

enum SeatingPreference {
  booth
  patio
  bar
  window
  quiet
  no_preference
}

enum CommunicationPreference {
  email_only
  sms_only
  both
  transactional_only
}

enum TableStatus {
  AVAILABLE
  OCCUPIED
  DIRTY
  READY
}

enum DepositStatus {
  pending
  held
  applied
  refunded
  partial_refunded
  forfeited
  uncollectable
}

enum DepositType {
  flat
  per_person
}

enum WaitlistStatus {
  waiting
  notified
  seated
  expired
  cancelled
}

enum EmailStatus {
  PENDING
  SENT
  FAILED
}

enum VenueRole {
  owner
  manager
  staff
}

model VenueGroup {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  settings  Json?
  venues    Venue[]
  createdAt DateTime @default(now()) @map("created_at")

  @@map("venue_groups")
}

model Venue {
  id                        String            @id @default(cuid())
  venueGroupId              String?           @map("venue_group_id")
  venueGroup                VenueGroup?       @relation(fields: [venueGroupId], references: [id])
  name                      String
  slug                      String
  ianaTimezone              String            @map("iana_timezone")
  currencyCode              String            @default("USD") @map("currency_code")
  operatingHours            Json?             @map("operating_hours")
  settings                  Json?
  // Deposit policy
  depositEnabled            Boolean           @default(false) @map("deposit_enabled")
  depositType               DepositType?      @map("deposit_type")
  depositAmountCents        Int?              @map("deposit_amount_cents")
  freeCancellationHours     Int?              @map("free_cancellation_hours")
  lateCancellationFeePercent Int?             @map("late_cancellation_fee_percent")
  noShowFeePercent          Int?              @map("no_show_fee_percent")
  tables                    Table[]
  reservations              Reservation[]
  guests                    Guest[]
  floorPlans                FloorPlan[]
  menus                     Menu[]
  floorPlanSections         FloorPlanSection[]
  holds                     ReservationHold[]
  reservationEvents         ReservationEvent[]
  tableEvents               TableEvent[]
  memberships               VenueMembership[]
  createdAt                 DateTime          @default(now()) @map("created_at")
  updatedAt                 DateTime          @updatedAt @map("updated_at")

  @@unique([venueGroupId, slug])
  @@index([venueGroupId])
  @@map("venues")
}

enum MenuStatus {
  DRAFT
  ACTIVE
  INACTIVE
}

enum MenuItemStatus {
  AVAILABLE
  SOLD_OUT
  HIDDEN
}

model Menu {
  id           String        @id @default(cuid())
  venueId      String        @map("venue_id")
  venue        Venue         @relation(fields: [venueId], references: [id])
  name         String
  slug         String
  description  String?
  status       MenuStatus    @default(DRAFT)
  displayOrder Int           @default(0) @map("display_order")
  sections     MenuSection[]
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")

  @@unique([venueId, slug])
  @@index([venueId, status])
  @@map("menus")
}

model MenuSection {
  id           String     @id @default(cuid())
  venueId      String     @map("venue_id")
  menuId       String     @map("menu_id")
  menu         Menu       @relation(fields: [menuId], references: [id], onDelete: Cascade)
  name         String
  displayOrder Int        @default(0) @map("display_order")
  items        MenuItem[]

  @@index([venueId])
  @@index([menuId, displayOrder])
  @@map("menu_sections")
}

model MenuItem {
  id           String         @id @default(cuid())
  venueId      String         @map("venue_id")
  sectionId    String         @map("section_id")
  section      MenuSection    @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  name         String
  description  String?
  priceCents   Int            @map("price_cents")
  status       MenuItemStatus @default(AVAILABLE)
  displayOrder Int            @default(0) @map("display_order")

  @@index([venueId])
  @@index([sectionId, displayOrder])
  @@map("menu_items")
}

model FloorPlan {
  id         String   @id @default(cuid())
  venueId    String   @map("venue_id")
  venue      Venue    @relation(fields: [venueId], references: [id])
  name       String
  isActive   Boolean  @default(false) @map("is_active")
  layoutJson Json     @map("layout_json")
  tables     Table[]
  sections   FloorPlanSection[]
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@index([venueId])
  @@index([venueId, isActive])
  @@map("floor_plans")
}

model FloorPlanSection {
  id           String    @id @default(cuid())
  venueId      String    @map("venue_id")
  venue        Venue     @relation(fields: [venueId], references: [id])
  floorPlanId  String    @map("floor_plan_id")
  floorPlan    FloorPlan @relation(fields: [floorPlanId], references: [id], onDelete: Cascade)
  name         String
  color        String    @default("#8a8a8a")
  displayOrder Int       @default(0) @map("display_order")
  tables       Table[]
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  @@index([venueId])
  @@index([floorPlanId, displayOrder])
  @@map("floor_plan_sections")
}

model Table {
  id            String            @id @default(cuid())
  name          String
  tableNumber   String?           @map("table_number")
  capacity      Int
  minCovers     Int               @default(1) @map("min_covers")
  maxCovers     Int?              @map("max_covers")
  location      String?
  isActive      Boolean           @default(true) @map("is_active")
  status        TableStatus       @default(AVAILABLE)
  priority      Int               @default(0)
  venueId       String?           @map("venue_id")
  venue         Venue?            @relation(fields: [venueId], references: [id])
  floorPlanId   String?           @map("floor_plan_id")
  floorPlan     FloorPlan?        @relation(fields: [floorPlanId], references: [id])
  sectionId     String?           @map("section_id")
  section       FloorPlanSection? @relation(fields: [sectionId], references: [id], onDelete: SetNull)
  shapeMetadata Json?             @map("shape_metadata")
  createdAt     DateTime          @default(now()) @map("created_at")
  updatedAt     DateTime          @updatedAt @map("updated_at")
  reservations  Reservation[]
  holds         ReservationHold[]
  events        TableEvent[]

  @@unique([venueId, name])
  @@index([venueId])
  @@index([floorPlanId])
  @@index([sectionId])
  @@map("tables")
}

model Guest {
  id                      String                  @id @default(cuid())
  venueId                 String                  @map("venue_id")
  venue                   Venue                   @relation(fields: [venueId], references: [id])
  email                   String?
  phone                   String?
  name                    String
  notes                   String?
  visitCount              Int                     @default(0) @map("visit_count")
  noShowCount             Int                     @default(0) @map("no_show_count")
  lastNoShowAt            DateTime?               @map("last_no_show_at")
  lifetimeSpend           Decimal?                @map("lifetime_spend") @db.Decimal(10, 2)
  lastVisit               DateTime?               @map("last_visit")
  tags                    Json?
  dietaryRestrictions     Json?                   @map("dietary_restrictions")
  staffNotes              Json?                   @map("staff_notes")
  communicationPreference CommunicationPreference @default(both) @map("communication_preference")
  stripeCustomerId        String?                 @unique @map("stripe_customer_id")
  unsubscribed            Boolean                 @default(false)
  reservations            Reservation[]
  createdAt               DateTime                @default(now()) @map("created_at")
  updatedAt               DateTime                @updatedAt @map("updated_at")

  @@unique([venueId, email])
  @@unique([venueId, phone])
  @@index([venueId])
  @@index([venueId, lastVisit])
  @@index([venueId, visitCount])
  @@map("guests")
}

model Reservation {
  id                 String             @id @default(cuid())
  date               DateTime           @db.Date
  startTime          DateTime           @map("start_time")
  endTime            DateTime           @map("end_time")
  partySize          Int                @map("party_size")
  status             ReservationStatus  @default(PENDING)
  notes              String?
  cancellationReason String?            @map("cancellation_reason")
  cancellationNote   String?            @map("cancellation_note")
  occasion           Occasion?
  seatingPreference  SeatingPreference? @map("seating_preference")
  emailStatus        EmailStatus?       @map("email_status")
  guestName          String?            @map("guest_name")
  guestEmail         String?            @map("guest_email")
  guestPhone         String?            @map("guest_phone")
  guestId            String?            @map("guest_id")
  guest              Guest?             @relation(fields: [guestId], references: [id])
  userId             String?            @map("user_id")
  tableId            String             @map("table_id")
  table              Table              @relation(fields: [tableId], references: [id])
  venueId            String?            @map("venue_id")
  venue              Venue?             @relation(fields: [venueId], references: [id])
  deposit            Deposit?
  events             ReservationEvent[]
  /// Booking-widget session (`ReservationHold.sessionId`) that confirmed this
  /// reservation. Proof of ownership for the public deposit route (#6304).
  /// Null for reservations created outside the widget.
  originSessionId    String?            @map("origin_session_id")
  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @updatedAt @map("updated_at")

  @@index([date, status])
  @@index([tableId, date])
  @@index([userId])
  @@index([venueId, date])
  @@index([guestId])
  @@map("reservations")
}

/// Append-only log of what happened to a reservation. The `reservations` row
/// stays the source of truth (not event sourcing; no backfill). `venueId` is
/// NOT NULL so rows can pass FORCE RLS WITH CHECK -- reservations with a NULL
/// `venueId` get no events. `app_reservations` holds SELECT + INSERT only.
model ReservationEvent {
  id            String      @id @default(cuid())
  reservationId String      @map("reservation_id")
  reservation   Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  venueId       String      @map("venue_id")
  venue         Venue       @relation(fields: [venueId], references: [id], onDelete: Cascade)
  kind          String
  actorType     String      @map("actor_type")
  actorId       String?     @map("actor_id")
  fromState     Json?       @map("from_state")
  toState       Json?       @map("to_state")
  createdAt     DateTime    @default(now()) @map("created_at")

  @@index([reservationId, createdAt])
  @@index([venueId, createdAt])
  @@map("reservation_events")
}

/// Append-only log of every `Table.status` transition. `Table.status` stays the
/// source of truth (not event sourcing; no backfill). `venueId` is NOT NULL so
/// rows can pass FORCE RLS WITH CHECK -- tables with a NULL `venueId` get no
/// events. `reservationId` is a plain column, not a FK: it names the booking a
/// transition belongs to (e.g. a walk-in seat) and must outlive it in history.
/// `app_reservations` holds SELECT + INSERT only.
model TableEvent {
  id            String      @id @default(cuid())
  tableId       String      @map("table_id")
  table         Table       @relation(fields: [tableId], references: [id], onDelete: Cascade)
  venueId       String      @map("venue_id")
  venue         Venue       @relation(fields: [venueId], references: [id], onDelete: Cascade)
  fromStatus    TableStatus @map("from_status")
  toStatus      TableStatus @map("to_status")
  actorType     String      @map("actor_type")
  actorId       String?     @map("actor_id")
  reservationId String?     @map("reservation_id")
  createdAt     DateTime    @default(now()) @map("created_at")

  @@index([tableId, createdAt])
  @@index([venueId, createdAt])
  @@map("table_events")
}

model Deposit {
  id                    String        @id @default(cuid())
  reservationId         String        @unique @map("reservation_id")
  reservation           Reservation   @relation(fields: [reservationId], references: [id])
  amountCents           Int           @map("amount_cents")
  currency              String        @default("usd")
  status                DepositStatus @default(pending)
  stripePaymentIntentId String?       @map("stripe_payment_intent_id")
  stripeCustomerId      String?       @map("stripe_customer_id")
  heldAt                DateTime?     @map("held_at")
  appliedAt             DateTime?     @map("applied_at")
  refundedAt            DateTime?     @map("refunded_at")
  forfeitedAt           DateTime?     @map("forfeited_at")
  /// Which flow set the deposit to `forfeited` ("no_show" | "cancellation" |
  /// "staff") — `forfeited` is produced by three different callers of
  /// DepositService#forfeit, and only a no-show retry replaying its OWN
  /// forfeit key is safe to recapture at its full amount (#5744 LOW-A).
  /// Nullable: rows written before this column existed have no known origin.
  forfeitOrigin         String?       @map("forfeit_origin")
  /// Set when a capture fails permanently (e.g. the ~7-day Stripe
  /// authorization expired and was auto-canceled) — the money is gone for
  /// good, so there's nothing left to reconcile against Stripe.
  uncollectableAt       DateTime?     @map("uncollectable_at")
  /// Persisted fee amount (in cents) at the time of a partial refund transition.
  /// Used to replay refundPartial on retry without re-deriving from the current clock.
  feeAmountCents        Int?          @map("fee_amount_cents")
  /// Persisted refund amount (in cents) at the time of a partial refund transition.
  /// Used to replay refundPartial on retry without re-deriving from the current clock.
  refundAmountCents     Int?          @map("refund_amount_cents")
  /// Cumulative amount (in cents), sourced directly from Stripe's own
  /// `amount_refunded` on the underlying charge, refunded AFTER this deposit
  /// already reached a capture-based terminal status (`applied`/`forfeited`/
  /// `partial_refunded`) — e.g. a refund issued through the Stripe dashboard
  /// after our own capture. Reconciliation only: does not change `status`,
  /// so the existing terminal status stays an accurate record of how our own
  /// state machine resolved the capture (#5725).
  postCaptureRefundCents Int?         @map("post_capture_refund_cents")
  createdAt             DateTime      @default(now()) @map("created_at")
  updatedAt             DateTime      @updatedAt @map("updated_at")

  @@index([reservationId])
  @@index([stripePaymentIntentId])
  @@index([status])
  @@map("deposits")
}

model WaitlistEntry {
  id                   String         @id @default(cuid())
  venueId              String         @map("venue_id")
  partySize            Int            @map("party_size")
  guestName            String         @map("guest_name")
  guestPhone           String         @map("guest_phone")
  position             Int
  estimatedWaitMinutes Int?           @map("estimated_wait_minutes")
  status               WaitlistStatus @default(waiting)
  notifiedAt           DateTime?      @map("notified_at")
  expiresAt            DateTime?      @map("expires_at")
  createdAt            DateTime       @default(now()) @map("created_at")
  updatedAt            DateTime       @updatedAt @map("updated_at")

  @@index([venueId, status])
  @@map("waitlist_entries")
}

model ReservationHold {
  id        String   @id @default(cuid())
  venueId   String   @map("venue_id")
  venue     Venue    @relation(fields: [venueId], references: [id])
  tableId   String   @map("table_id")
  table     Table    @relation(fields: [tableId], references: [id])
  date      DateTime @db.Date
  startTime DateTime @map("start_time")
  endTime   DateTime @map("end_time")
  partySize Int      @map("party_size")
  sessionId String   @map("session_id")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([venueId, date])
  @@index([tableId, date])
  @@index([expiresAt])
  @@index([sessionId])
  @@map("reservation_holds")
}

/// Fine-grained operator ↔ venue authorization (ADR-020). Keyed to the Auth0
/// `sub`; queried per request by requireVenueAccess so a revoked membership
/// denies access immediately, without waiting for a JWT refresh.
model VenueMembership {
  id        String    @id @default(cuid())
  userSub   String    @map("user_sub")
  venueId   String    @map("venue_id")
  venue     Venue     @relation(fields: [venueId], references: [id], onDelete: Cascade)
  role      VenueRole @default(staff)
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  @@unique([userSub, venueId])
  @@index([userSub])
  @@index([venueId])
  @@map("venue_memberships")
}
