generator client {
  provider        = "prisma-client-js"
  output          = "../src/generated/prisma"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

enum ReservationStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
  NO_SHOW
}

enum Occasion {
  birthday
  anniversary
  business
  date_night
  other
  none
}

enum SeatingPreference {
  booth
  patio
  bar
  window
  quiet
  no_preference
}

enum CommunicationPreference {
  email_only
  sms_only
  both
  transactional_only
}

enum TableStatus {
  AVAILABLE
  OCCUPIED
  DIRTY
  READY
}

/// The floor finish a section is painted with. Each value has a committed
/// tiling texture in apps/hospitality/public/floor-plan/textures.
enum FloorMaterial {
  hardwood
  concrete
  carpet
  tile
  marble
}

enum DepositStatus {
  pending
  held
  applied
  refunded
  partial_refunded
  forfeited
  uncollectable
}

enum DepositType {
  flat
  per_person
}

enum WaitlistStatus {
  waiting
  notified
  seated
  expired
  cancelled
}

enum EmailStatus {
  PENDING
  SENT
  FAILED
}

enum VenueRole {
  owner
  manager
  staff
}

model VenueGroup {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  settings  Json?
  venues    Venue[]
  createdAt DateTime @default(now()) @map("created_at")

  @@map("venue_groups")
}

model Venue {
  id                        String            @id @default(cuid())
  venueGroupId              String?           @map("venue_group_id")
  venueGroup                VenueGroup?       @relation(fields: [venueGroupId], references: [id])
  name                      String
  slug                      String
  ianaTimezone              String            @map("iana_timezone")
  currencyCode              String            @default("USD") @map("currency_code")
  operatingHours            Json?             @map("operating_hours")
  settings                  Json?
  // Deposit policy
  depositEnabled            Boolean           @default(false) @map("deposit_enabled")
  depositType               DepositType?      @map("deposit_type")
  depositAmountCents        Int?              @map("deposit_amount_cents")
  freeCancellationHours     Int?              @map("free_cancellation_hours")
  lateCancellationFeePercent Int?             @map("late_cancellation_fee_percent")
  noShowFeePercent          Int?              @map("no_show_fee_percent")
  tables                    Table[]
  reservations              Reservation[]
  guests                    Guest[]
  floorPlans                FloorPlan[]
  menus                     Menu[]
  floorPlanSections         FloorPlanSection[]
  holds                     ReservationHold[]
  reservationEvents         ReservationEvent[]
  tableEvents               TableEvent[]
  memberships               VenueMembership[]
  schedules                 Schedule[]
  venueServices             VenueService[]
  scheduleServices          ScheduleService[]
  scheduleAssignments       ScheduleAssignment[]
  dateRules                 DateRule[]
  dateRuleTables            DateRuleTable[]
  availabilityChanges       AvailabilityChange[]
  closureOutcomes           ClosureOutcome[]
  /// Per-venue compare-and-set counter for availability config saves (ADR-030).
  availabilityVersion       Int               @default(0) @map("availability_version")
  /// Host "stop all online bookings" switch.
  hostEmergencyClose        Boolean           @default(false) @map("host_emergency_close")
  createdAt                 DateTime          @default(now()) @map("created_at")
  updatedAt                 DateTime          @updatedAt @map("updated_at")

  @@unique([venueGroupId, slug])
  @@index([venueGroupId])
  @@map("venues")
}

enum MenuStatus {
  DRAFT
  ACTIVE
  INACTIVE
}

enum MenuItemStatus {
  AVAILABLE
  SOLD_OUT
  HIDDEN
}

model Menu {
  id           String        @id @default(cuid())
  venueId      String        @map("venue_id")
  venue        Venue         @relation(fields: [venueId], references: [id])
  name         String
  slug         String
  description  String?
  status       MenuStatus    @default(DRAFT)
  displayOrder Int           @default(0) @map("display_order")
  sections     MenuSection[]
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")

  @@unique([venueId, slug])
  @@index([venueId, status])
  @@map("menus")
}

model MenuSection {
  id           String     @id @default(cuid())
  venueId      String     @map("venue_id")
  menuId       String     @map("menu_id")
  menu         Menu       @relation(fields: [menuId], references: [id], onDelete: Cascade)
  name         String
  displayOrder Int        @default(0) @map("display_order")
  items        MenuItem[]

  @@index([venueId])
  @@index([menuId, displayOrder])
  @@map("menu_sections")
}

model MenuItem {
  id           String         @id @default(cuid())
  venueId      String         @map("venue_id")
  sectionId    String         @map("section_id")
  section      MenuSection    @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  name         String
  description  String?
  priceCents   Int            @map("price_cents")
  status       MenuItemStatus @default(AVAILABLE)
  displayOrder Int            @default(0) @map("display_order")

  @@index([venueId])
  @@index([sectionId, displayOrder])
  @@map("menu_items")
}

model FloorPlan {
  id         String   @id @default(cuid())
  venueId    String   @map("venue_id")
  venue      Venue    @relation(fields: [venueId], references: [id])
  name       String
  isActive   Boolean  @default(false) @map("is_active")
  layoutJson Json     @map("layout_json")
  tables     Table[]
  sections   FloorPlanSection[]
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@index([venueId])
  @@index([venueId, isActive])
  @@map("floor_plans")
}

model FloorPlanSection {
  id           String    @id @default(cuid())
  venueId      String    @map("venue_id")
  venue        Venue     @relation(fields: [venueId], references: [id])
  floorPlanId  String    @map("floor_plan_id")
  floorPlan    FloorPlan @relation(fields: [floorPlanId], references: [id], onDelete: Cascade)
  name         String
  color        String    @default("#8a8a8a")
  displayOrder Int       @default(0) @map("display_order")
  /// Null means no floor finish: the zone renders as it did before materials existed.
  floorMaterial FloorMaterial? @map("floor_material")
  tables       Table[]
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  @@index([venueId])
  @@index([floorPlanId, displayOrder])
  @@map("floor_plan_sections")
}

model Table {
  id            String            @id @default(cuid())
  name          String
  tableNumber   String?           @map("table_number")
  capacity      Int
  minCovers     Int               @default(1) @map("min_covers")
  maxCovers     Int?              @map("max_covers")
  location      String?
  isActive      Boolean           @default(true) @map("is_active")
  status        TableStatus       @default(AVAILABLE)
  priority      Int               @default(0)
  venueId       String?           @map("venue_id")
  venue         Venue?            @relation(fields: [venueId], references: [id])
  floorPlanId   String?           @map("floor_plan_id")
  floorPlan     FloorPlan?        @relation(fields: [floorPlanId], references: [id])
  sectionId     String?           @map("section_id")
  section       FloorPlanSection? @relation(fields: [sectionId], references: [id], onDelete: SetNull)
  shapeMetadata Json?             @map("shape_metadata")
  dateRuleTables DateRuleTable[]
  createdAt     DateTime          @default(now()) @map("created_at")
  updatedAt     DateTime          @updatedAt @map("updated_at")
  reservations  Reservation[]
  holds         ReservationHold[]
  events        TableEvent[]

  @@unique([venueId, name])
  @@index([venueId])
  @@index([floorPlanId])
  @@index([sectionId])
  @@map("tables")
}

model Guest {
  id                      String                  @id @default(cuid())
  venueId                 String                  @map("venue_id")
  venue                   Venue                   @relation(fields: [venueId], references: [id])
  email                   String?
  phone                   String?
  name                    String
  notes                   String?
  visitCount              Int                     @default(0) @map("visit_count")
  noShowCount             Int                     @default(0) @map("no_show_count")
  lastNoShowAt            DateTime?               @map("last_no_show_at")
  lifetimeSpend           Decimal?                @map("lifetime_spend") @db.Decimal(10, 2)
  lastVisit               DateTime?               @map("last_visit")
  tags                    Json?
  dietaryRestrictions     Json?                   @map("dietary_restrictions")
  staffNotes              Json?                   @map("staff_notes")
  communicationPreference CommunicationPreference @default(both) @map("communication_preference")
  stripeCustomerId        String?                 @unique @map("stripe_customer_id")
  unsubscribed            Boolean                 @default(false)
  reservations            Reservation[]
  createdAt               DateTime                @default(now()) @map("created_at")
  updatedAt               DateTime                @updatedAt @map("updated_at")

  @@unique([venueId, email])
  @@unique([venueId, phone])
  @@index([venueId])
  @@index([venueId, lastVisit])
  @@index([venueId, visitCount])
  @@map("guests")
}

model Reservation {
  id                 String             @id @default(cuid())
  date               DateTime           @db.Date
  startTime          DateTime           @map("start_time")
  endTime            DateTime           @map("end_time")
  partySize          Int                @map("party_size")
  status             ReservationStatus  @default(PENDING)
  notes              String?
  cancellationReason String?            @map("cancellation_reason")
  cancellationNote   String?            @map("cancellation_note")
  occasion           Occasion?
  seatingPreference  SeatingPreference? @map("seating_preference")
  emailStatus        EmailStatus?       @map("email_status")
  guestName          String?            @map("guest_name")
  guestEmail         String?            @map("guest_email")
  guestPhone         String?            @map("guest_phone")
  guestId            String?            @map("guest_id")
  guest              Guest?             @relation(fields: [guestId], references: [id])
  userId             String?            @map("user_id")
  tableId            String             @map("table_id")
  table              Table              @relation(fields: [tableId], references: [id])
  venueId            String?            @map("venue_id")
  venue              Venue?             @relation(fields: [venueId], references: [id])
  deposit            Deposit?
  events             ReservationEvent[]
  /// Booking-widget session (`ReservationHold.sessionId`) that confirmed this
  /// reservation. Proof of ownership for the public deposit route (#6304).
  /// Null for reservations created outside the widget.
  originSessionId    String?            @map("origin_session_id")
  /// Staff reason for booking past a soft availability limit (ADR-030 `judge`).
  overrideReason     String?            @map("override_reason")
  /// The soft limits that were overridden (after_last_seating, pacing, ...). NULL = none.
  overrideLimits     String[]           @map("override_limits")
  closureOutcomes        ClosureOutcome[] @relation("ClosureOutcomeReservation")
  rebookedFromOutcomes   ClosureOutcome[] @relation("ClosureOutcomeRebooked")
  createdAt         DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @updatedAt @map("updated_at")

  @@index([date, status])
  @@index([tableId, date])
  @@index([userId])
  @@index([venueId, date])
  @@index([guestId])
  @@map("reservations")
}

/// Append-only log of what happened to a reservation. The `reservations` row
/// stays the source of truth (not event sourcing; no backfill). `venueId` is
/// NOT NULL so rows can pass FORCE RLS WITH CHECK -- reservations with a NULL
/// `venueId` get no events. `app_reservations` holds SELECT + INSERT only.
model ReservationEvent {
  id            String      @id @default(cuid())
  reservationId String      @map("reservation_id")
  reservation   Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  venueId       String      @map("venue_id")
  venue         Venue       @relation(fields: [venueId], references: [id], onDelete: Cascade)
  kind          String
  actorType     String      @map("actor_type")
  actorId       String?     @map("actor_id")
  fromState     Json?       @map("from_state")
  toState       Json?       @map("to_state")
  createdAt     DateTime    @default(now()) @map("created_at")

  @@index([reservationId, createdAt])
  @@index([venueId, createdAt])
  @@map("reservation_events")
}

/// Append-only log of every `Table.status` transition. `Table.status` stays the
/// source of truth (not event sourcing; no backfill). `venueId` is NOT NULL so
/// rows can pass FORCE RLS WITH CHECK -- tables with a NULL `venueId` get no
/// events. `reservationId` is a plain column, not a FK: it names the booking a
/// transition belongs to (e.g. a walk-in seat) and must outlive it in history.
/// `app_reservations` holds SELECT + INSERT only.
model TableEvent {
  id            String      @id @default(cuid())
  tableId       String      @map("table_id")
  table         Table       @relation(fields: [tableId], references: [id], onDelete: Cascade)
  venueId       String      @map("venue_id")
  venue         Venue       @relation(fields: [venueId], references: [id], onDelete: Cascade)
  fromStatus    TableStatus @map("from_status")
  toStatus      TableStatus @map("to_status")
  actorType     String      @map("actor_type")
  actorId       String?     @map("actor_id")
  reservationId String?     @map("reservation_id")
  createdAt     DateTime    @default(now()) @map("created_at")

  @@index([tableId, createdAt])
  @@index([venueId, createdAt])
  @@map("table_events")
}

model Deposit {
  id                    String        @id @default(cuid())
  reservationId         String        @unique @map("reservation_id")
  reservation           Reservation   @relation(fields: [reservationId], references: [id])
  amountCents           Int           @map("amount_cents")
  currency              String        @default("usd")
  status                DepositStatus @default(pending)
  stripePaymentIntentId String?       @map("stripe_payment_intent_id")
  stripeCustomerId      String?       @map("stripe_customer_id")
  heldAt                DateTime?     @map("held_at")
  appliedAt             DateTime?     @map("applied_at")
  refundedAt            DateTime?     @map("refunded_at")
  forfeitedAt           DateTime?     @map("forfeited_at")
  /// Which flow set the deposit to `forfeited` ("no_show" | "cancellation" |
  /// "staff") — `forfeited` is produced by three different callers of
  /// DepositService#forfeit, and only a no-show retry replaying its OWN
  /// forfeit key is safe to recapture at its full amount (#5744 LOW-A).
  /// Nullable: rows written before this column existed have no known origin.
  forfeitOrigin         String?       @map("forfeit_origin")
  /// Set when a capture fails permanently (e.g. the ~7-day Stripe
  /// authorization expired and was auto-canceled) — the money is gone for
  /// good, so there's nothing left to reconcile against Stripe.
  uncollectableAt       DateTime?     @map("uncollectable_at")
  /// Persisted fee amount (in cents) at the time of a partial refund transition.
  /// Used to replay refundPartial on retry without re-deriving from the current clock.
  feeAmountCents        Int?          @map("fee_amount_cents")
  /// Persisted refund amount (in cents) at the time of a partial refund transition.
  /// Used to replay refundPartial on retry without re-deriving from the current clock.
  refundAmountCents     Int?          @map("refund_amount_cents")
  /// Cumulative amount (in cents), sourced directly from Stripe's own
  /// `amount_refunded` on the underlying charge, refunded AFTER this deposit
  /// already reached a capture-based terminal status (`applied`/`forfeited`/
  /// `partial_refunded`) — e.g. a refund issued through the Stripe dashboard
  /// after our own capture. Reconciliation only: does not change `status`,
  /// so the existing terminal status stays an accurate record of how our own
  /// state machine resolved the capture (#5725).
  postCaptureRefundCents Int?         @map("post_capture_refund_cents")
  createdAt             DateTime      @default(now()) @map("created_at")
  updatedAt             DateTime      @updatedAt @map("updated_at")

  @@index([reservationId])
  @@index([stripePaymentIntentId])
  @@index([status])
  @@map("deposits")
}

model WaitlistEntry {
  id                   String         @id @default(cuid())
  venueId              String         @map("venue_id")
  partySize            Int            @map("party_size")
  guestName            String         @map("guest_name")
  guestPhone           String         @map("guest_phone")
  position             Int
  estimatedWaitMinutes Int?           @map("estimated_wait_minutes")
  status               WaitlistStatus @default(waiting)
  notifiedAt           DateTime?      @map("notified_at")
  expiresAt            DateTime?      @map("expires_at")
  createdAt            DateTime       @default(now()) @map("created_at")
  updatedAt            DateTime       @updatedAt @map("updated_at")

  @@index([venueId, status])
  @@map("waitlist_entries")
}

model ReservationHold {
  id        String   @id @default(cuid())
  venueId   String   @map("venue_id")
  venue     Venue    @relation(fields: [venueId], references: [id])
  tableId   String   @map("table_id")
  table     Table    @relation(fields: [tableId], references: [id])
  date      DateTime @db.Date
  startTime DateTime @map("start_time")
  endTime   DateTime @map("end_time")
  partySize Int      @map("party_size")
  sessionId String   @map("session_id")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([venueId, date])
  @@index([tableId, date])
  @@index([expiresAt])
  @@index([sessionId])
  @@map("reservation_holds")
}

/// Fine-grained operator ↔ venue authorization (ADR-020). Keyed to the Auth0
/// `sub`; queried per request by requireVenueAccess so a revoked membership
/// denies access immediately, without waiting for a JWT refresh.
model VenueMembership {
  id        String    @id @default(cuid())
  userSub   String    @map("user_sub")
  venueId   String    @map("venue_id")
  venue     Venue     @relation(fields: [venueId], references: [id], onDelete: Cascade)
  role      VenueRole @default(staff)
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  @@unique([userSub, venueId])
  @@index([userSub])
  @@index([venueId])
  @@map("venue_memberships")
}

// ── Venue availability (ADR-030) ────────────────────────────────────────────
// Layered rows resolved by the pure @mbe/availability engine. Times are minutes
// from the service day's local midnight; `closesAt` may exceed 1440. jsonb
// payloads carry a `version` and are parsed with the zod schemas in
// @mbe/types (availability-config.ts) on read. Every table is venue-scoped
// (`venue_id` NOT NULL) with ENABLE + FORCE RLS (ADR-026).

enum ScheduleKind {
  regular
  alternate
  holiday
}

enum DateRuleKind {
  special_hours
  closure
  use_schedule
  skip
  tonight
}

enum DateRuleTargetKind {
  venue
  service
  booking
  tables
}

enum DateRuleSource {
  manual
  holiday
  tonight
}

enum ClosureAction {
  cancel
  move
  keep_notify
  keep_silent
}

enum ClosureRefundStatus {
  none
  pending
  done
  failed
}

/// A named weekly (or holiday) pattern of services. Exactly one non-archived
/// `isRegular` schedule per venue: partial unique index
/// `schedules_one_regular_per_venue_key`, declared below via the
/// `partialIndexes` preview feature so `prisma migrate dev` cannot drop it.
model Schedule {
  id          String       @id @default(cuid())
  venueId     String       @map("venue_id")
  venue       Venue        @relation(fields: [venueId], references: [id])
  name        String
  kind        ScheduleKind
  isRegular   Boolean      @default(false) @map("is_regular")
  archivedAt  DateTime?    @map("archived_at")
  services    ScheduleService[]
  assignments ScheduleAssignment[]
  dateRules   DateRule[]
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  @@index([venueId])
  @@unique([venueId], where: raw("\"is_regular\" AND \"archived_at\" IS NULL"), map: "schedules_one_regular_per_venue_key")
  @@map("schedules")
}

/// The venue-wide identity of a service ("Dinner"). Closures, Compare and later
/// policies/events reference this row, never a name.
model VenueService {
  id               String    @id @default(cuid())
  venueId          String    @map("venue_id")
  venue            Venue     @relation(fields: [venueId], references: [id])
  name             String
  position         Int       @default(0)
  archivedAt       DateTime? @map("archived_at")
  scheduleServices ScheduleService[]
  dateRules        DateRule[]

  @@index([venueId, position])
  @@map("venue_services")
}

model ScheduleService {
  id             String       @id @default(cuid())
  venueId        String       @map("venue_id")
  venue          Venue        @relation(fields: [venueId], references: [id])
  scheduleId     String       @map("schedule_id")
  schedule       Schedule     @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  venueServiceId String       @map("venue_service_id")
  venueService   VenueService @relation(fields: [venueServiceId], references: [id])
  opensAt        Int          @map("opens_at")
  lastSeatingAt  Int          @map("last_seating_at")
  closesAt       Int          @map("closes_at")
  /// {version:1, interval} | {version:1, fixed:[minutes]}
  seating        Json
  /// Subset of {online, phone}; empty = walk-in only.
  bookingTypes   String[]     @default([]) @map("booking_types")
  /// Versioned value bundle (P3 turn times, pacing, party limits, windows).
  rules          Json         @default("{}")

  @@unique([scheduleId, venueServiceId])
  @@index([venueId])
  @@index([venueServiceId])
  @@map("schedule_services")
}

model ScheduleAssignment {
  id         String    @id @default(cuid())
  venueId    String    @map("venue_id")
  venue      Venue     @relation(fields: [venueId], references: [id])
  scheduleId String    @map("schedule_id")
  schedule   Schedule  @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  /// 0 = Sunday.
  weekdays   Int[]
  startsOn   DateTime? @map("starts_on") @db.Date
  endsOn     DateTime? @map("ends_on") @db.Date
  /// Larger wins where assignments overlap.
  precedence Int       @default(0)

  @@index([venueId])
  @@index([scheduleId])
  @@map("schedule_assignments")
}

/// A dated override layer: special hours, closure, use-schedule, skip, tonight.
/// Soft-deleted via `deletedAt`. `sectionId` (P3) is deliberately absent.
model DateRule {
  id             String             @id @default(cuid())
  venueId        String             @map("venue_id")
  venue          Venue              @relation(fields: [venueId], references: [id])
  kind           DateRuleKind
  targetKind     DateRuleTargetKind @default(venue) @map("target_kind")
  venueServiceId String?            @map("venue_service_id")
  venueService   VenueService?      @relation(fields: [venueServiceId], references: [id], onDelete: Restrict)
  /// Subset of {online, phone, waitlist}; empty = all channels.
  bookingTypes   String[]           @default([]) @map("booking_types")
  tables         DateRuleTable[]
  startsOn       DateTime           @map("starts_on") @db.Date
  /// NULL = "until I reopen".
  endsOn         DateTime?          @map("ends_on") @db.Date
  /// {version:1, weekdays:[..]} within [startsOn, endsOn].
  repeat         Json?
  /// {version:1, from, to} minutes; NULL = whole service day.
  window         Json?
  /// special_hours: services[]; tonight: {pacing|closeAt|stop}.
  payload        Json               @default("{}")
  useScheduleId  String?            @map("use_schedule_id")
  useSchedule    Schedule?          @relation(fields: [useScheduleId], references: [id], onDelete: Restrict)
  /// Skip / edit-one-date rows point at the series root.
  seriesId       String?            @map("series_id")
  series         DateRule?          @relation("DateRuleSeries", fields: [seriesId], references: [id], onDelete: SetNull)
  seriesMembers  DateRule[]         @relation("DateRuleSeries")
  source         DateRuleSource     @default(manual)
  holidayKey     String?            @map("holiday_key")
  bookingOpensAt DateTime?          @map("booking_opens_at")
  guestMessage   String?            @map("guest_message") @db.VarChar(200)
  staffNote      String?            @map("staff_note")
  /// Tonight rules only: the venue's service-day boundary, set at write time.
  expiresAt      DateTime?          @map("expires_at") @db.Timestamptz(3)
  createdBy      String             @map("created_by")
  createdAt      DateTime           @default(now()) @map("created_at")
  deletedAt      DateTime?          @map("deleted_at")
  outcomes       ClosureOutcome[]

  @@index([venueId, startsOn])
  @@index([venueServiceId])
  @@index([useScheduleId])
  @@index([seriesId])
  @@map("date_rules")
}

/// FK join rows for `DateRule.targetKind = tables`.
model DateRuleTable {
  dateRuleId String   @map("date_rule_id")
  dateRule   DateRule @relation(fields: [dateRuleId], references: [id], onDelete: Cascade)
  tableId    String   @map("table_id")
  table      Table    @relation(fields: [tableId], references: [id], onDelete: Cascade)
  venueId    String   @map("venue_id")
  venue      Venue    @relation(fields: [venueId], references: [id])

  @@id([dateRuleId, tableId])
  @@index([tableId])
  @@index([venueId])
  @@map("date_rule_tables")
}

/// Audit + undo log of availability edits. Append-only: `app_reservations`
/// holds SELECT + INSERT, plus a column-level UPDATE on `reverted_by` only
/// (marking a change as undone); no DELETE. `affectedFrom/To` replace the
/// architecture's `daterange` column (Prisma has no native type for it).
model AvailabilityChange {
  id             String    @id @default(cuid())
  venueId        String    @map("venue_id")
  venue          Venue     @relation(fields: [venueId], references: [id])
  actorId        String    @map("actor_id")
  at             DateTime  @default(now())
  kind           String
  summary        String
  affectedFrom   DateTime? @map("affected_from") @db.Date
  affectedTo     DateTime? @map("affected_to") @db.Date
  /// Rows to restore/delete to undo this change.
  inverse        Json
  notifiedGuests Boolean   @default(false) @map("notified_guests")
  /// The change that undid this one.
  revertedById   String?   @map("reverted_by")
  revertedBy     AvailabilityChange?  @relation("AvailabilityChangeRevert", fields: [revertedById], references: [id], onDelete: Restrict)
  reverts        AvailabilityChange[] @relation("AvailabilityChangeRevert")

  @@index([venueId, at])
  @@index([revertedById])
  @@map("availability_changes")
}

/// What happened to each reservation overlapping a saved closure.
model ClosureOutcome {
  id                     String              @id @default(cuid())
  venueId                String              @map("venue_id")
  venue                  Venue               @relation(fields: [venueId], references: [id])
  dateRuleId             String              @map("date_rule_id")
  dateRule               DateRule            @relation(fields: [dateRuleId], references: [id])
  reservationId          String              @map("reservation_id")
  reservation            Reservation         @relation("ClosureOutcomeReservation", fields: [reservationId], references: [id])
  action                 ClosureAction
  movedTo                DateTime?           @map("moved_to") @db.Timestamptz(3)
  /// {email: sent|failed|skipped, sms: ...}
  deliveries             Json                @default("{}")
  refund                 ClosureRefundStatus @default(none)
  rebookedReservationId  String?             @map("rebooked_reservation_id")
  rebookedReservation    Reservation?        @relation("ClosureOutcomeRebooked", fields: [rebookedReservationId], references: [id], onDelete: SetNull)
  /// keep_silent: who acknowledged the guest would not be told.
  acknowledgedBy         String?             @map("acknowledged_by")
  createdAt              DateTime            @default(now()) @map("created_at")
  updatedAt              DateTime            @updatedAt @map("updated_at")

  @@unique([dateRuleId, reservationId])
  @@index([venueId])
  @@index([reservationId])
  @@index([rebookedReservationId])
  @@map("closure_outcomes")
}
