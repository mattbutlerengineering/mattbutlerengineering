generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ReservationStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
  NO_SHOW
}

enum TableStatus {
  AVAILABLE
  OCCUPIED
  DIRTY
  READY
}

model VenueGroup {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  settings  Json?
  venues    Venue[]
  createdAt DateTime @default(now()) @map("created_at")

  @@map("venue_groups")
}

model Venue {
  id             String            @id @default(cuid())
  venueGroupId   String?           @map("venue_group_id")
  venueGroup     VenueGroup?       @relation(fields: [venueGroupId], references: [id])
  name           String
  slug           String            @unique
  ianaTimezone   String            @map("iana_timezone")
  currencyCode   String            @default("USD") @map("currency_code")
  operatingHours Json?             @map("operating_hours")
  settings       Json?
  tables         Table[]
  reservations   Reservation[]
  guests         Guest[]
  floorPlans     FloorPlan[]
  holds          ReservationHold[]
  createdAt      DateTime          @default(now()) @map("created_at")
  updatedAt      DateTime          @updatedAt @map("updated_at")

  @@map("venues")
}

model FloorPlan {
  id         String   @id @default(cuid())
  venueId    String   @map("venue_id")
  venue      Venue    @relation(fields: [venueId], references: [id])
  name       String
  isActive   Boolean  @default(false) @map("is_active")
  layoutJson Json     @map("layout_json")
  tables     Table[]
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@index([venueId])
  @@index([venueId, isActive])
  @@map("floor_plans")
}

model Table {
  id            String            @id @default(cuid())
  name          String            @unique
  tableNumber   String?           @map("table_number")
  capacity      Int
  minCovers     Int               @default(1) @map("min_covers")
  maxCovers     Int?              @map("max_covers")
  location      String?
  isActive      Boolean           @default(true) @map("is_active")
  status        TableStatus       @default(AVAILABLE)
  priority      Int               @default(0)
  venueId       String?           @map("venue_id")
  venue         Venue?            @relation(fields: [venueId], references: [id])
  floorPlanId   String?           @map("floor_plan_id")
  floorPlan     FloorPlan?        @relation(fields: [floorPlanId], references: [id])
  shapeMetadata Json?             @map("shape_metadata")
  createdAt     DateTime          @default(now()) @map("created_at")
  updatedAt     DateTime          @updatedAt @map("updated_at")
  reservations  Reservation[]
  holds         ReservationHold[]

  @@index([venueId])
  @@index([floorPlanId])
  @@map("tables")
}

model Guest {
  id            String        @id @default(cuid())
  venueId       String        @map("venue_id")
  venue         Venue         @relation(fields: [venueId], references: [id])
  email         String?
  phone         String?
  name          String
  notes         String?
  visitCount    Int           @default(0) @map("visit_count")
  lifetimeSpend Decimal?      @map("lifetime_spend") @db.Decimal(10, 2)
  lastVisit     DateTime?     @map("last_visit")
  tags          Json?
  reservations  Reservation[]
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  @@unique([venueId, email])
  @@unique([venueId, phone])
  @@index([venueId])
  @@index([venueId, lastVisit])
  @@map("guests")
}

model Reservation {
  id         String            @id @default(cuid())
  date       DateTime          @db.Date
  startTime  DateTime          @map("start_time")
  endTime    DateTime          @map("end_time")
  partySize  Int               @map("party_size")
  status             ReservationStatus @default(PENDING)
  notes              String?
  cancellationReason String?           @map("cancellation_reason")
  cancellationNote   String?           @map("cancellation_note")
  guestName          String?           @map("guest_name")
  guestEmail String?           @map("guest_email")
  guestPhone String?           @map("guest_phone")
  guestId    String?           @map("guest_id")
  guest      Guest?            @relation(fields: [guestId], references: [id])
  userId     String?           @map("user_id")
  tableId    String            @map("table_id")
  table      Table             @relation(fields: [tableId], references: [id])
  venueId    String?           @map("venue_id")
  venue      Venue?            @relation(fields: [venueId], references: [id])
  createdAt  DateTime          @default(now()) @map("created_at")
  updatedAt  DateTime          @updatedAt @map("updated_at")

  @@index([date, status])
  @@index([tableId, date])
  @@index([userId])
  @@index([venueId, date])
  @@index([guestId])
  @@map("reservations")
}

model ReservationHold {
  id        String   @id @default(cuid())
  venueId   String   @map("venue_id")
  venue     Venue    @relation(fields: [venueId], references: [id])
  tableId   String   @map("table_id")
  table     Table    @relation(fields: [tableId], references: [id])
  date      DateTime @db.Date
  startTime DateTime @map("start_time")
  endTime   DateTime @map("end_time")
  partySize Int      @map("party_size")
  sessionId String   @map("session_id")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([venueId, date])
  @@index([tableId, date])
  @@index([expiresAt])
  @@index([sessionId])
  @@map("reservation_holds")
}
