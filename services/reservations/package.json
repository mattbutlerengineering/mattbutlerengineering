{
  "name": "@mbe/reservations-service",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "build:openapi": "tsx -e \"import { buildApp } from './src/app.js'; (async () => { const app = await buildApp({ logger: false }); await app.ready(); console.log(JSON.stringify(app.swagger(), null, 2)); })()\" > openapi.json",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:contract": "vitest run src/routes/contract.test.ts",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src/",
    "typecheck": "tsc --noEmit",
    "postinstall": "prisma generate",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:migrate:status": "prisma migrate status",
    "db:studio": "prisma studio",
    "db:backfill-availability": "tsx src/scripts/backfill-availability.ts"
  },
  "dependencies": {
    "@fastify/rate-limit": "^11.2.1",
    "@mbe/auth": "workspace:*",
    "@mbe/availability": "workspace:*",
    "@mbe/cancellation-policy": "workspace:*",
    "@mbe/database": "workspace:*",
    "@mbe/sentry": "workspace:*",
    "@mbe/service-bootstrap": "workspace:*",
    "@mbe/types": "workspace:*",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@prisma/client-runtime-utils": "^7.10.1",
    "bullmq": "^6.4.0",
    "fastify": "catalog:",
    "ioredis": "^6.0.0",
    "jose": "^6.2.13",
    "pg": "^8.23.1",
    "resend": "^6.34.1",
    "stripe": "^23.0.1",
    "twilio": "^6.2.0"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "devDependencies": {
    "@mbe/config": "workspace:*",
    "@types/node": "catalog:",
    "@types/pg": "^8.23.1",
    "@vitest/coverage-v8": "catalog:",
    "prisma": "^7.10.1",
    "tsx": "^4.23.15",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "license": "MIT"
}
