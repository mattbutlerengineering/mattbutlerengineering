# Database
DATABASE_URL="postgresql://mbe:mbe_dev_password@localhost:5432/mbe_agent?schema=public"

# Prisma connection pool size (optional — default: 5)
# PRISMA_CONNECTION_LIMIT=5

# Server
PORT=3003
HOST=0.0.0.0
LOG_LEVEL=info

# CORS
CORS_ORIGINS=http://localhost:3000

# Agent defaults
DEFAULT_MODEL=claude-sonnet-4-6
DEFAULT_MAX_TURNS=50
DEFAULT_MAX_BUDGET_USD=1.00
MAX_CONCURRENT_SESSIONS=5

# Anthropic API key (required for agent sessions)
# ANTHROPIC_API_KEY=sk-ant-...

# Sentry (optional — omit to disable error tracking)
# SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
# Sentry environment tag (optional — unset falls back to NODE_ENV)
# SENTRY_ENVIRONMENT=production

# Auth (Auth0)
AUTH_AUTHORITY=https://mattbutlerengineering.auth0.com
AUTH_AUDIENCE=https://api.mattbutlerengineering.com
# Auth0 JWKS endpoint override (optional). Unset: derived from AUTH_AUTHORITY,
# with a dev-tenant fallback outside production. Consulted by the /ready health check.
# AUTH0_JWKS_URL=https://your-tenant.auth0.com/.well-known/jwks.json
# Test-only auth bypass (NEVER set in production): when "true" AND NODE_ENV=test,
# requests opting in via the bypass header skip JWT validation and receive a
# hardcoded admin identity. Unset, or NODE_ENV != test: bypass never activates.
# AUTH_BYPASS_IN_TESTS=true

# Observability (OpenTelemetry / Langfuse)
# Disables the OTel SDK entirely when "true" (e.g. in tests). Unset: enabled.
# OTEL_SDK_DISABLED=false
# Enables Langfuse trace export (optional — also needs LANGFUSE_SECRET_KEY).
# Unset: Langfuse export is skipped, zero overhead.
# LANGFUSE_PUBLIC_KEY=pk-lf-...

# GitHub
GITHUB_TOKEN=your_github_pat
GITHUB_WEBHOOK_SECRET=your_webhook_secret
REMEDIATION_WEBHOOK_SECRET=your_remediation_secret
REPO_PATH=https://github.com/mattbutlerengineering/mattbutlerengineering

# Public URLs
AGENT_API_URL=http://localhost:3003
API_BASE_URL=http://localhost:3000
