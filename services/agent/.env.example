# Database
DATABASE_URL="postgresql://mbe:mbe_dev_password@localhost:5432/mbe_agent?schema=public"

# Server
PORT=3003
HOST=0.0.0.0
LOG_LEVEL=info

# CORS
CORS_ORIGIN=http://localhost:3000

# Agent defaults
DEFAULT_MODEL=claude-sonnet-4-6
DEFAULT_MAX_TURNS=50
DEFAULT_MAX_BUDGET_USD=1.00
MAX_CONCURRENT_SESSIONS=5

# Anthropic API key (required for agent sessions)
# ANTHROPIC_API_KEY=sk-ant-...

# Sentry (optional — omit to disable error tracking)
# SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
