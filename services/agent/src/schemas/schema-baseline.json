{
  "CreateSessionBody": {
    "$id": "CreateSessionBody",
    "type": "object",
    "properties": {
      "taskDescription": {
        "type": "string",
        "minLength": 1,
        "maxLength": 10000
      },
      "model": {
        "type": "string"
      },
      "maxTurns": {
        "type": "number",
        "minimum": 1,
        "maximum": 200
      },
      "maxBudgetUsd": {
        "type": "number",
        "minimum": 0.01,
        "maximum": 10
      },
      "baseBranch": {
        "type": "string"
      },
      "createPr": {
        "type": "boolean"
      },
      "parentId": {
        "type": "string"
      }
    },
    "required": ["taskDescription"]
  },
  "AgentError": {
    "$id": "AgentError",
    "type": "object",
    "required": ["error", "message", "statusCode"],
    "properties": {
      "error": {
        "type": "string",
        "example": "Not Found"
      },
      "message": {
        "type": "string",
        "example": "Session not found"
      },
      "statusCode": {
        "type": "number",
        "example": 404
      }
    }
  },
  "AgentPagination": {
    "$id": "AgentPagination",
    "type": "object",
    "required": ["page", "limit", "total", "totalPages", "hasNext", "hasPrev"],
    "properties": {
      "page": {
        "type": "number",
        "example": 1
      },
      "limit": {
        "type": "number",
        "example": 10
      },
      "total": {
        "type": "number",
        "example": 42
      },
      "totalPages": {
        "type": "number",
        "example": 5
      },
      "hasNext": {
        "type": "boolean",
        "example": true
      },
      "hasPrev": {
        "type": "boolean",
        "example": false
      }
    }
  },
  "SessionEvent": {
    "$id": "SessionEvent",
    "type": "object",
    "properties": {
      "id": {
        "type": "string"
      },
      "sessionId": {
        "type": "string"
      },
      "type": {
        "type": "string"
      },
      "data": {
        "type": "object",
        "propertyNames": {
          "type": "string"
        }
      },
      "createdAt": {
        "type": "string"
      }
    },
    "required": ["id", "sessionId", "type", "createdAt"]
  },
  "Session": {
    "$id": "Session",
    "type": "object",
    "properties": {
      "id": {
        "type": "string"
      },
      "status": {
        "type": "string",
        "enum": ["PENDING", "RUNNING", "SUCCEEDED", "FAILED", "CANCELLED"]
      },
      "taskDescription": {
        "type": "string"
      },
      "branchName": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ]
      },
      "baseBranch": {
        "type": "string"
      },
      "model": {
        "type": "string"
      },
      "maxTurns": {
        "type": "number"
      },
      "maxBudgetUsd": {
        "type": "number"
      },
      "createPr": {
        "type": "boolean"
      },
      "prUrl": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ]
      },
      "prNumber": {
        "anyOf": [
          {
            "type": "number"
          },
          {
            "type": "null"
          }
        ]
      },
      "resultText": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ]
      },
      "costUsd": {
        "anyOf": [
          {
            "type": "number"
          },
          {
            "type": "null"
          }
        ]
      },
      "inputTokens": {
        "anyOf": [
          {
            "type": "number"
          },
          {
            "type": "null"
          }
        ]
      },
      "outputTokens": {
        "anyOf": [
          {
            "type": "number"
          },
          {
            "type": "null"
          }
        ]
      },
      "numTurns": {
        "anyOf": [
          {
            "type": "number"
          },
          {
            "type": "null"
          }
        ]
      },
      "durationMs": {
        "anyOf": [
          {
            "type": "number"
          },
          {
            "type": "null"
          }
        ]
      },
      "parentId": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ]
      },
      "errors": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "startedAt": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ]
      },
      "completedAt": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ]
      },
      "createdAt": {
        "type": "string"
      },
      "updatedAt": {
        "type": "string"
      }
    },
    "required": [
      "id",
      "status",
      "taskDescription",
      "branchName",
      "baseBranch",
      "model",
      "maxTurns",
      "maxBudgetUsd",
      "prUrl",
      "prNumber",
      "resultText",
      "costUsd",
      "inputTokens",
      "outputTokens",
      "numTurns",
      "durationMs",
      "parentId",
      "errors",
      "startedAt",
      "completedAt",
      "createdAt",
      "updatedAt"
    ]
  }
}
