{
  "name": "@mbe/agent-service",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/index.ts",
    "build": "tsc",
    "build:openapi": "tsx -e \"import { buildApp } from './src/app.js'; (async () => { const app = await buildApp({ logger: false }); await app.ready(); console.log(JSON.stringify(app.swagger(), null, 2)); })()\" > openapi.json",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:contract": "vitest run src/routes/contract.test.ts",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src/",
    "typecheck": "tsc --noEmit",
    "postinstall": "prisma generate",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:migrate:status": "prisma migrate status",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.36",
    "@fastify/cors": "^11.3.0",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/swagger": "^9.8.1",
    "@fastify/swagger-ui": "^6.1.1",
    "@mbe/agent-core": "workspace:*",
    "@mbe/api-client": "workspace:^",
    "@mbe/auth": "workspace:^",
    "@mbe/database": "workspace:*",
    "@mbe/observability": "workspace:*",
    "@mbe/rialto-catalog": "workspace:^",
    "@mbe/sentry": "workspace:*",
    "@mbe/service-bootstrap": "workspace:*",
    "@mbe/types": "workspace:*",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "@prisma/client-runtime-utils": "^7.9.1",
    "@scalar/fastify-api-reference": "^1.64.1",
    "ai": "^7.0.58",
    "fastify": "catalog:",
    "pg": "^8.23.0",
    "zod": "catalog:"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "devDependencies": {
    "@mbe/agent-test-utils": "workspace:*",
    "@mbe/config": "workspace:*",
    "@types/node": "catalog:",
    "@types/pg": "^8.21.0",
    "@vitest/coverage-v8": "catalog:",
    "prisma": "^7.9.1",
    "tsx": "^4.23.11",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "license": "MIT",
  "acmm": {
    "inherit": true,
    "globalPaths": [
      ".github/workflows/",
      ".github/PULL_REQUEST_TEMPLATE.md",
      ".github/pull_request_template.md",
      ".github/ISSUE_TEMPLATE/",
      ".github/policies/",
      ".github/auto-qa-tuning.json",
      ".github/risk-assessment.yml",
      ".github/labeler.yml",
      "CONTRIBUTING.md",
      "SECURITY-AI.md",
      "docs/ai-ops-runbook.md",
      "docs/rollback-drill.md",
      "docs/reflections/",
      "docs/autonomous-work-log.md",
      "scripts/acmm/",
      "scripts/build-accm-history.mjs",
      "scripts/orchestrate.mjs",
      ".claude/settings.json",
      ".claude/risk-config.json",
      "memory/",
      "knowledge.jsonl",
      "CODEOWNERS",
      ".github/CODEOWNERS",
      "risk-config.json"
    ]
  }
}
