{
  "name": "@mbe/agent-service",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/index.ts",
    "build": "tsc",
    "build:openapi": "tsx -e \"import { buildApp } from './src/app.js'; (async () => { const app = await buildApp({ logger: false }); await app.ready(); console.log(JSON.stringify(app.swagger(), null, 2)); })()\" > openapi.json",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:contract": "vitest run src/routes/contract.test.ts",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src/",
    "typecheck": "tsc --noEmit",
    "postinstall": "prisma generate",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:migrate:status": "prisma migrate status",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.81",
    "@fastify/rate-limit": "^11.2.1",
    "@json-render/core": "^0.21.1",
    "@mbe/agent-core": "workspace:*",
    "@mbe/api-client": "workspace:^",
    "@mbe/auth": "workspace:^",
    "@mbe/database": "workspace:*",
    "@mbe/rialto-catalog": "workspace:^",
    "@mbe/sentry": "workspace:*",
    "@mbe/service-bootstrap": "workspace:*",
    "@mbe/types": "workspace:*",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@prisma/client-runtime-utils": "^7.10.1",
    "ai": "^7.0.142",
    "fastify": "catalog:",
    "pg": "^8.23.1",
    "zod": "catalog:"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "devDependencies": {
    "@json-render/react": "^0.21.1",
    "@mbe/config": "workspace:*",
    "@types/node": "catalog:",
    "@types/pg": "^8.23.1",
    "@vitest/coverage-v8": "catalog:",
    "prisma": "^7.10.1",
    "tsx": "^4.23.15",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "license": "MIT"
}
