#!/bin/sh

# Guard: refuse a push whose destination ref is `main` (#4664).
#
# Runs FIRST and costs milliseconds: a commit pushed straight to main never
# runs pull_request CI, so the cheapest possible refusal is the right one.
# The refs being pushed arrive on this hook's STDIN as
# "<local ref> <local sha> <remote ref> <remote sha>" lines — never from the
# command line — so the guard reads stdin and nothing below it does. The
# decision itself is the pure, unit-tested classifyPushTarget()
# (scripts/__tests__/guard-direct-push-to-main.test.mjs); this is the wiring.
# The refusal message names the ALLOW_DIRECT_MAIN_PUSH override, which exists
# so repo policy's "security fixes go straight to main" stays possible without
# reaching for `--no-verify` (which would disable every gate below too).
if ! node scripts/guard-direct-push-to-main.mjs check; then
  exit 1
fi

# The destructive-migration check and the antipattern ratchet are NOT run here
# (#9069): pre-commit runs the ratchet, CI runs both, and `--no-verify` skips
# every hook anyway, so a pre-push copy only repeated work.

# Gate the expensive CLI-build + full-regen path on whether this branch's diff
# actually touches generated-artifact sources (scripts/check-regen-needed.mjs,
# backed by REGEN_SOURCE_PREFIXES in regen-manifest.mjs — the same gate the
# implement-queue worker uses). Docs-only / test-only / workflow-only pushes
# skip ~2 minutes of build + regen.
#
# Safety: CI's build job still runs the authoritative `pnpm regen && pnpm regen
# --check --git-only` on every PR and main push, so a wrong "check" verdict here can only
# delay drift detection to CI — never let it land. If the gating script itself
# fails (missing origin/main, etc.), fail safe to the full path.
REGEN_MODE=$(node scripts/check-regen-needed.mjs 2>/dev/null) || REGEN_MODE=full

# Fail-safe direction: anything other than an explicit "check" verdict
# (including unexpected output) takes the full path.
if [ "$REGEN_MODE" != "check" ]; then
  # Build CLI and its transitive deps before running regen, matching the order
  # CI uses (`pnpm build && pnpm regen`). Turbo caches the build so this is
  # near-instant when CLI source is unchanged.
  echo "pre-push: building CLI for regen..."
  if ! pnpm build --filter @mbe/cli...; then
    echo ""
    echo "ERROR: CLI build failed — fix the TypeScript errors above before pushing."
    echo "Emergency bypass: git push --no-verify"
    echo ""
    exit 1
  fi

  # Run the full artifact regeneration before checking. This mirrors what CI does:
  # `pnpm regen` (regenerate) then `pnpm regen --check` (verify the regen was
  # a no-op vs the working tree). Running only --check on a diff that touches
  # regen sources was the prior bug: it compared working-tree vs index, passing
  # even when the committed artifacts were stale relative to what CI would
  # generate from scratch.
  echo "pre-push: regenerating generated artifacts..."
  if ! pnpm regen; then
    echo ""
    echo "ERROR: artifact regeneration failed — fix the error above before pushing."
    echo "Emergency bypass: git push --no-verify"
    echo ""
    exit 1
  fi
else
  echo "pre-push: no generated-artifact sources changed — skipping CLI build + regen (fast path)"
fi

# Always run the cheap output-cleanliness check (git status of committed
# artifacts, no regeneration): catches hand-edited or uncommitted artifact
# files on both paths for ~0 cost.
# CI's Build job remains the authoritative regen gate either way.
if ! pnpm regen --check; then
  echo ""
  echo "ERROR: generated artifacts are out of sync (stale artifact + fix command shown above)."
  echo "Stage the changed files and amend/create a new commit before pushing."
  echo "Emergency bypass: git push --no-verify"
  echo ""
  exit 1
fi

