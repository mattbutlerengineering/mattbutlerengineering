#!/bin/sh

pnpm lint-staged

# `check-adr` below reaches @mbe/agent-core through the CLI's module graph, and
# packages/agent-core/dist is gitignored — so a fresh worktree has none and the
# commit aborts with an opaque ERR_MODULE_NOT_FOUND stack trace that says
# nothing about what to do. Rebuild it when it cannot be proven fresh: a cheap
# mtime comparison that only builds when it has to (#3989).
#
# This is preparation, not a check. The helper never throws, but it exits 1 when
# the dist still cannot be proven fresh — which matters for the PR-risk
# classifier, not for check-adr. Letting that abort the commit would turn a
# build-cache detail into a hard block, so it degrades to one actionable line
# and check-adr stays the gate.
node scripts/agent-core-build-freshness.mjs check >/dev/null 2>&1 ||
  echo "pre-commit: could not prove packages/agent-core/dist is fresh. If check-adr fails below, run: pnpm build --filter @mbe/cli..." >&2

pnpm --filter @mbe/cli start check-adr --staged

# Secret scanning — skip if gitleaks is not installed
if command -v gitleaks >/dev/null 2>&1; then
  gitleaks protect --staged --config .gitleaks.toml --verbose
fi

# Security scanning with Semgrep — scan only staged files so per-commit
# latency scales with change size, not the full repo size.
# Try --staged first (limits the scan to the git index). Fall back to
# --git (includes staged + unstaged dirty files) for older installs that
# lack --staged. Either is far faster than a whole-tree scan.
if command -v semgrep >/dev/null 2>&1; then
  if semgrep --help 2>&1 | grep -q '\-\-staged'; then
    semgrep --config semgrep.yml --error --staged
  else
    semgrep --config semgrep.yml --error --git
  fi
fi
